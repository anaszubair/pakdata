---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../i18n/utils';
import { languages } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  imageAlt?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { 
  title = "Pakistan Data Management Services", 
  description = "Pioneering Islamic digital innovation and software development since 1979. Creators of Quran Majeed, EasyUrdu, and custom enterprise solutions.",
  imageAlt,
  noindex = false,
  schema = []
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const dir = lang === 'en' ? 'ltr' : 'rtl';
// The site is prerendered, so the in-app webview mode (?webview=1, ?view=app or ?ua=qmapp)
// is applied in the browser by the inline script in <head>.
const siteOrigin = (Astro.site ?? new URL('https://pakdata.com')).origin;
const siteHost = new URL(siteOrigin).hostname;
const defaultDescription = 'Pioneering Islamic digital innovation and software development since 1979. Creators of Quran Majeed, EasyUrdu, Quran Pak, and enterprise technology platforms.';
const fallbackSocialImage = '/images/social-preview.png';
const socialImageWidth = 1200;
const socialImageHeight = 630;

const buildPageTitle = (pageTitle: string) => {
  const trimmedTitle = pageTitle?.trim() || 'Pakistan Data Management Services';
  return /\b(PDMS|Pakdata|Pakistan Data Management Services)\b/i.test(trimmedTitle)
    ? trimmedTitle
    : `${trimmedTitle} | PDMS`;
};

const fullTitle = buildPageTitle(title);
const pageDescription = description?.trim() || defaultDescription;

// URLs never end in a slash (trailingSlash: 'never'), except the root.
const normalizePath = (path: string) => {
  const clean = path || '/';
  if (clean === '/') return clean;
  return clean.endsWith('/') ? clean.slice(0, -1) : clean;
};

const stripTrailingSlash = (path: string) => {
  if (path === '/') return path;
  return path.endsWith('/') ? path.slice(0, -1) : path;
};

const toAbsoluteUrl = (pathOrUrl: string) => {
  try {
    return new URL(pathOrUrl).toString();
  } catch {
    return new URL(pathOrUrl, siteOrigin).toString();
  }
};

// Helper to determine active link
const pathname = Astro.url.pathname;
const cleanPathname = pathname.replace(new RegExp(`^/${lang}(?=/|$)`), '') || '/';
const normalizedCleanPathname = normalizePath(cleanPathname);
const productPathKey = stripTrailingSlash(normalizedCleanPathname);
const canonicalPath = normalizePath(getRelativeLocaleUrl(lang, normalizedCleanPathname));
const canonicalUrl = toAbsoluteUrl(canonicalPath);
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const alternateLocales = Object.keys(languages).map((locale) => ({
  lang: locale,
  href: toAbsoluteUrl(normalizePath(getRelativeLocaleUrl(locale as keyof typeof languages, normalizedCleanPathname)))
}));
const defaultLocaleUrl = toAbsoluteUrl(normalizePath(getRelativeLocaleUrl('en', normalizedCleanPathname)));
const ogLocaleMap: Record<string, string> = {
  en: 'en_US',
  ur: 'ur_PK',
  ar: 'ar_AR'
};
const ogLocale = ogLocaleMap[lang] ?? 'en_US';

const humanizeSegment = (segment: string) => decodeURIComponent(segment)
  .replace(/-/g, ' ')
  .replace(/\b\w/g, char => char.toUpperCase());

const breadcrumbSegments = normalizedCleanPathname.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: toAbsoluteUrl(getRelativeLocaleUrl(lang, '/'))
  },
  ...breadcrumbSegments.map((segment, index) => {
    const itemPath = `/${breadcrumbSegments.slice(0, index + 1).join('/')}`;
    return {
      '@type': 'ListItem',
      position: index + 2,
      name: humanizeSegment(segment),
      item: toAbsoluteUrl(normalizePath(getRelativeLocaleUrl(lang, itemPath)))
    };
  })
];

const routeSocialImages: Record<string, string> = {
  '/': '/images/quranscreen.webp',
  '/products': '/images/quranscreen.webp',
  '/products/quran-majeed': '/images/quranmajeed/IMG_0167-768x999.png',
  '/products/quran-majeed-mac': '/images/Mac.png',
  '/products/quran-pak': '/images/quranpak/unnamed.webp',
  '/products/easyurdu': '/images/easyurdu/unnamed.webp',
  '/products/easysindhi': '/images/easysindhi/1.jpeg',
  '/products/hadith-app': '/images/hadith/unnamed.webp',
  '/products/3d-salah-guide': '/images/3DSalah/unnamed.webp',
  '/products/kitabi': '/images/kitabi/unnamed-3.webp',
  '/products/arabicfont': '/images/quranmajeed/Quran-Majeed.png',
  '/projects': '/images/nadra.jpg',
  '/nadra-citizens-database': '/images/nadra.jpg',
  '/projects/nara-national-alien-registration-authority': '/images/nara-screenshot-350x316.jpg',
  '/projects/quran-printing-complex-project': '/images/quran-complex-screen1.jpg',
  '/projects/quranexplorer': '/images/q_explorer_sc.png',
  '/projects/imagine': '/images/imagine.jpg',
  '/quran-audio': '/images/quranaudio.webp',
  '/qm-audio-download-instructions': '/images/qm-audio-download2.png',
  '/certificates': '/images/certificates/QuranArabicTextCorrectCertificate.gif',
  '/fix_adhan_notification': '/images/generic/1-1-480x853.png',
  '/fix_adhan_notification/generic': '/images/generic/1-1-480x853.png',
  '/fix_adhan_notification/huawei': '/images/huawei/fixadhanissue1.jpg',
  '/fix_adhan_notification/samsung': '/images/samsung/01.-Settings.png',
  '/fix_adhan_notification/OnePlus': '/images/oneplus/fixissue1.png'
};
const socialImage = toAbsoluteUrl(fallbackSocialImage);
const socialImageAlt = imageAlt?.trim() || `${fullTitle} preview image`;
const socialImageType = 'image/png';

const productSchemas: Record<string, Record<string, unknown>> = {
  '/products/quran-majeed': {
    name: 'Quran Majeed',
    applicationCategory: 'ReferenceApplication',
    operatingSystem: 'Android, iOS, macOS',
    image: toAbsoluteUrl(routeSocialImages['/products/quran-majeed']),
    additionalProperty: [
      {
        '@type': 'PropertyValue',
        name: 'Downloads',
        value: '100M+'
      }
    ]
  },
  '/products/quran-pak': {
    name: 'Quran Pak',
    applicationCategory: 'ReferenceApplication',
    operatingSystem: 'iOS',
    image: toAbsoluteUrl(routeSocialImages['/products/quran-pak']),
  },
  '/products/easyurdu': {
    name: 'Easy Urdu Keyboard',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Android',
    image: toAbsoluteUrl(routeSocialImages['/products/easyurdu'])
  },
  '/products/easysindhi': {
    name: 'Easy Sindhi Keyboard',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Android',
    image: toAbsoluteUrl(routeSocialImages['/products/easysindhi'])
  },
  '/products/hadith-app': {
    name: 'Hadith App',
    applicationCategory: 'ReferenceApplication',
    operatingSystem: 'iOS',
    image: toAbsoluteUrl(routeSocialImages['/products/hadith-app'])
  },
  '/products/3d-salah-guide': {
    name: '3D Salah Guide',
    applicationCategory: 'EducationApplication',
    operatingSystem: 'iOS',
    image: toAbsoluteUrl(routeSocialImages['/products/3d-salah-guide'])
  },
  '/products/kitabi': {
    name: 'Kitabi',
    applicationCategory: 'BooksApplication',
    operatingSystem: 'Android, iOS',
    image: toAbsoluteUrl(routeSocialImages['/products/kitabi'])
  },
  '/products/quran-majeed-mac': {
    name: 'Quran Majeed Mac',
    applicationCategory: 'ReferenceApplication',
    operatingSystem: 'macOS',
    image: toAbsoluteUrl(routeSocialImages['/products/quran-majeed-mac'])
  }
};

const productSchema = productSchemas[productPathKey]
  ? {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    ...productSchemas[productPathKey],
    url: canonicalUrl,
    description: pageDescription,
    publisher: {
      '@type': 'Organization',
      name: 'Pakistan Data Management Services',
      url: siteOrigin
    },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    }
  }
  : null;

const pageSchemaType = normalizedCleanPathname === '/about-us' ? 'AboutPage' : 'WebPage';
const baseSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteOrigin}/#organization`,
    name: 'Pakistan Data Management Services',
    alternateName: 'PDMS',
    url: siteOrigin,
    logo: toAbsoluteUrl('/images/logo.png'),
    foundingDate: '1979',
    email: 'support@pakdata.com',
    telephone: '+92-21-34559003',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'NASTP-2 Silicon Valley-2, Building S2, 1st Floor, Office No.15, Main Shahrah-e-Faisal',
      addressLocality: 'Karachi',
      addressCountry: 'PK'
    },
    sameAs: [
      'https://linkedin.com/company/pakdata',
      'https://twitter.com/pakdata',
      'https://facebook.com/pakdata'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteOrigin}/#website`,
    url: siteOrigin,
    name: 'Pakistan Data Management Services',
    publisher: {
      '@id': `${siteOrigin}/#organization`
    },
    inLanguage: lang
  },
  {
    '@context': 'https://schema.org',
    '@type': pageSchemaType,
    '@id': `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: fullTitle,
    description: pageDescription,
    image: socialImage,
    isPartOf: {
      '@id': `${siteOrigin}/#website`
    },
    about: {
      '@id': `${siteOrigin}/#organization`
    },
    inLanguage: lang
  },
  ...(breadcrumbSegments.length > 0 ? [{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems
  }] : []),
  ...(productSchema ? [productSchema] : [])
];
const allSchemas = [...baseSchemas, ...(Array.isArray(schema) ? schema : [schema])];
const isActive = (path: string) => {
  if (path === '/' && cleanPathname === '/') return true;
  if (path !== '/' && cleanPathname.startsWith(path)) return true;
  return false;
};

const productLinks = [
  {
    href: getRelativeLocaleUrl(lang, '/products/quran-majeed'),
    label: t('nav.product.qm')
  },
  {
    href: getRelativeLocaleUrl(lang, '/products/quran-majeed-mac'),
    label: t('nav.product.qmMac')
  },
  {
    href: getRelativeLocaleUrl(lang, '/products/quran-pak'),
    label: t('nav.product.qp')
  },
  {
    href: getRelativeLocaleUrl(lang, '/products/hadith-app'),
    label: t('nav.product.hadith')
  },
  {
    href: getRelativeLocaleUrl(lang, '/products/3d-salah-guide'),
    label: t('nav.product.salah')
  },
  {
    href: getRelativeLocaleUrl(lang, '/products/easyurdu'),
    label: t('nav.product.eu')
  },
  {
    href: getRelativeLocaleUrl(lang, '/products/easysindhi'),
    label: t('nav.product.es')
  },
  {
    href: getRelativeLocaleUrl(lang, '/products/arabicfont'),
    label: t('nav.product.font')
  },
  {
    href: getRelativeLocaleUrl(lang, '/products/kitabi'),
    label: t('nav.product.kitabi')
  },
  {
    href: getRelativeLocaleUrl(lang, '/products'),
    label: t('nav.product.more')
  }
];

const projectLinks = [
  {
    href: getRelativeLocaleUrl(lang, '/projects/nadra-software'),
    label: 'NADRA'
  },
  {
    href: getRelativeLocaleUrl(lang, '/projects/quran-printing-complex-project'),
    label: 'King Fahad'
  },
  {
    href: getRelativeLocaleUrl(lang, '/projects/quranexplorer'),
    label: 'QuranExplorer'
  },
  {
    href: getRelativeLocaleUrl(lang, '/projects/nara-national-alien-registration-authority'),
    label: 'NARA'
  },
  {
    href: getRelativeLocaleUrl(lang, '/projects/imagine'),
    label: 'Imagine'
  }
];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png?v=2" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    {lang === 'ur' && (
      <link rel="preload" href="/fonts/noto-nastaliq-urdu-400.woff2" as="font" type="font/woff2" crossorigin />
    )}
    <meta name="generator" content={Astro.generator} />
    <meta name="build-version" content={`${__BUILD_INFO__.version} ${__BUILD_INFO__.commit} ${__BUILD_INFO__.buildTime}`} />
    <meta name="google-site-verification" content="3-szp3quXwmwNF3NIavdt_lCGIpMTQQxnC3UMxRumHI" />
    <script is:inline>
      // In-app webview mode: hide the site header and footer.
      (() => {
        // Only applies while the query parameter is in the URL.
        const apply = () => {
          const params = new URLSearchParams(window.location.search);
          const webview =
            params.get('webview') === '1' ||
            params.get('view') === 'app' ||
            params.get('ua') === 'qmapp';
          // Clear the flag older builds kept for the tab session.
          try { sessionStorage.removeItem('pdms-webview'); } catch {}
          document.documentElement.classList.toggle('webview-shell', webview);
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="robots" content={robotsContent} />
    {!noindex && alternateLocales.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />}
    
    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0f7a55" />
    <meta itemprop="name" content={fullTitle} />
    <meta itemprop="description" content={pageDescription} />
    <meta itemprop="image" content={socialImage} />

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn / Google Chat -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pakistan Data Management Services" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={socialImageWidth.toString()} />
    <meta property="og:image:height" content={socialImageHeight.toString()} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {alternateLocales.filter((alternate) => alternate.lang !== lang).map((alternate) => (
      <meta property="og:locale:alternate" content={ogLocaleMap[alternate.lang] ?? alternate.lang} />
    ))}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content={siteHost} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    {allSchemas.map((schemaItem) => (
      <script type="application/ld+json" set:html={JSON.stringify(schemaItem)} />
    ))}
    <ClientRouter fallback="swap" />

    <style is:global>
      /* Noto Nastaliq Urdu (SIL OFL, see /fonts/OFL-NotoNastaliqUrdu.txt), Arabic-script subset.
         About 155 KB per weight; the old Jameel Noori file was 6.6 MB.
         Noto renders about 1.55x wider than Jameel Noori at the same size, so size-adjust
         shrinks it back to the footprint the Urdu layout was designed for. */
      @font-face {
        font-family: 'Noto Nastaliq Urdu';
        src:
          url('/fonts/noto-nastaliq-urdu-400.woff2') format('woff2');
        font-weight: 400;
        size-adjust: 65%;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+200C-200E, U+FB50-FDFF, U+FE70-FEFF;
      }
      @font-face {
        font-family: 'Noto Nastaliq Urdu';
        src:
          url('/fonts/noto-nastaliq-urdu-700.woff2') format('woff2');
        font-weight: 700;
        size-adjust: 65%;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+200C-200E, U+FB50-FDFF, U+FE70-FEFF;
      }
      @font-face {
        font-family: 'PDMS Arabic';
        src:
          url('/fonts/ar-site.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF;
      }
      :lang(ur), :lang(ur) *, 
      :lang(ur) h1, :lang(ur) h2, :lang(ur) h3, :lang(ur) h4, :lang(ur) h5, :lang(ur) h6, :lang(ur) p, :lang(ur) a, :lang(ur) span, :lang(ur) div {
        font-family: 'Noto Nastaliq Urdu', 'Noto Naskh Arabic', Arial, sans-serif !important;
      }
      html:lang(ur) {
        line-height: 2.2;
        --text-scale: 1.25;
      }
      :lang(ar), :lang(ar) *, 
      :lang(ar) h1, :lang(ar) h2, :lang(ar) h3, :lang(ar) h4, :lang(ar) h5, :lang(ar) h6, :lang(ar) p, :lang(ar) a, :lang(ar) span, :lang(ar) div {
        font-family: 'PDMS Arabic', 'Amiri', 'Noto Naskh Arabic', 'Traditional Arabic', Arial, sans-serif !important;
      }
      html:lang(ar) {
        line-height: 2;
        --text-scale: 1.25;
      }
      html:lang(ur) .btn,
      html:lang(ur) button,
      html:lang(ur) select,
      html:lang(ur) .badge,
      html:lang(ur) .nav-link,
      html:lang(ur) .nav-dropdown-item,
      html:lang(ur) .tab-btn {
        line-height: 1;
      }
      html:lang(ur) .btn,
      html:lang(ur) .tab-btn,
      html:lang(ur) .badge,
      html:lang(ur) .nav-link,
      html:lang(ur) .nav-dropdown-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      html:lang(ur) .btn {
        min-height: 2.75rem;
        padding-top: 0;
        padding-bottom: 0.35rem;
      }
      html:lang(ur) .btn-sm,
      html:lang(ur) .header-cta {
        min-height: 2.5rem;
      }
      html:lang(ur) .btn-sm,
      html:lang(ur) .tab-btn,
      html:lang(ur) .lang-selector {
        font-size: 0.875rem;
      }
      html:lang(ur) .btn-lg {
        font-size: 1.125rem;
        min-height: 3.25rem;
      }
      html:lang(ur) .badge {
        font-size: 0.75rem;
        min-height: 1.5rem;
        padding-top: 0;
        padding-bottom: 0.2rem;
      }
      html:lang(ur) .nav-link {
        font-size: 0.9375rem;
        min-height: 2.25rem;
        padding-top: 0;
        padding-bottom: 0.25rem;
      }
      html:lang(ur) .nav-dropdown-item {
        font-size: 0.92rem;
        min-height: 2.25rem;
        padding-top: 0;
        padding-bottom: 0.3rem;
        justify-content: flex-start;
      }
      html:lang(ur) .lang-selector {
        height: 2.625rem;
        padding-top: 0;
        padding-bottom: 0.25rem;
      }
      html:lang(ur) .tab-btn {
        min-height: 2.875rem;
        padding-top: 0;
        padding-bottom: 0.35rem;
      }
    </style>
  </head>
  <body>

    <!-- Navigation Header -->
    <header class="header" id="site-header">
      <div class="container header-container">
        <!-- Logo -->
        <a href={getRelativeLocaleUrl(lang, '/')} class="logo-wrap" id="logo-nav-link">
          <img src="/images/logo-header.webp" alt={t('a11y.logoAlt')} class="logo-img" width="320" height="124" fetchpriority="high" decoding="async" />
          <div class="logo-text">
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="nav-desktop">
          <a href={getRelativeLocaleUrl(lang, '/')} class={`nav-link ${isActive('/') ? 'active' : ''}`} id="nav-home">{t('nav.home')}</a>
          <div class={`nav-dropdown ${isActive('/projects') ? 'active' : ''}`} id="nav-projects-wrap">
            <a href={getRelativeLocaleUrl(lang, '/projects')} class={`nav-link nav-dropdown-link ${isActive('/projects') ? 'active' : ''}`} id="nav-projects">{t('nav.projects')}<svg class="nav-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <div class="nav-dropdown-menu" id="projects-dropdown-menu">
              {projectLinks.map((item) => (
                <a href={item.href} class="nav-dropdown-item">{item.label}</a>
              ))}
            </div>
          </div>
          <div class={`nav-dropdown ${isActive('/products') ? 'active' : ''}`} id="nav-products-wrap">
            <a href={getRelativeLocaleUrl(lang, '/products')} class={`nav-link nav-dropdown-link ${isActive('/products') ? 'active' : ''}`} id="nav-products">{t('nav.products')}<svg class="nav-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <div class="nav-dropdown-menu" id="products-dropdown-menu">
              {productLinks.map((item) => (
                <a href={item.href} class="nav-dropdown-item">{item.label}</a>
              ))}
            </div>
          </div>
          <a href={getRelativeLocaleUrl(lang, '/about-us')} class={`nav-link ${isActive('/about-us') ? 'active' : ''}`} id="nav-about">{t('nav.about')}</a>
          <a href={getRelativeLocaleUrl(lang, '/our-team')} class={`nav-link ${isActive('/our-team') ? 'active' : ''}`} id="nav-team">{t('nav.team')}</a>
          <a href={getRelativeLocaleUrl(lang, '/support')} class={`nav-link ${isActive('/support') ? 'active' : ''}`} id="nav-support">{t('nav.support')}</a>
          <a href={getRelativeLocaleUrl(lang, '/job-us')} class={`nav-link ${isActive('/job-us') ? 'active' : ''}`} id="nav-join">{t('nav.join')}</a>
        </nav>

        <!-- CTA Header Button & Language Selector -->
        <div class="header-cta-wrap">
          <div class="lang-selector-wrap">
            <select class="lang-selector" data-lang-selector aria-label={t('a11y.selectLanguage')}>
              {Object.entries(languages).map(([l, name]) => (
                <option value={getRelativeLocaleUrl(l as any, cleanPathname)} selected={l === lang}>{name}</option>
              ))}
            </select>
          </div>
