    <!-- Interactive Navigation Scripts -->
    <script>
      import { navigate } from 'astro:transitions/client';
      import { mountRecaptcha, type RecaptchaWidget } from '../lib/recaptcha';

      // Site key of the Sendy install at mailer.pakdata.com. Sendy holds the matching secret.
      const SENDY_RECAPTCHA_SITE_KEY = '6LcTD70bAAAAAKW0ntBeE6r8shx9OODb0wkWq_OT';

      let scrollController: AbortController | undefined;

      document.addEventListener('astro:before-preparation', () => {
        document.body.classList.remove('overflow-hidden');
        document.documentElement.classList.remove('menu-open', 'header-hidden');
      });

      document.addEventListener('astro:page-load', () => {
        const siteHeader = document.getElementById('site-header');
        const menuToggleBtn = document.getElementById('menu-toggle-btn');
        const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
        const newsletterForm = document.getElementById('newsletter-form');

        const setMenuOpen = (open: boolean) => {
          if (!menuToggleBtn || !mobileMenuDrawer) return;
          const wasOpen = mobileMenuDrawer.classList.contains('active');
          menuToggleBtn.classList.toggle('active', open);
          menuToggleBtn.setAttribute('aria-expanded', String(open));
          const label = open ? menuToggleBtn.dataset.labelClose : menuToggleBtn.dataset.labelOpen;
          if (label) menuToggleBtn.setAttribute('aria-label', label);
          mobileMenuDrawer.classList.toggle('active', open);
          document.body.classList.toggle('overflow-hidden', open);
          document.documentElement.classList.toggle('menu-open', open);
          if (open && !wasOpen) {
            mobileMenuDrawer.querySelector<HTMLElement>('a, summary, select')?.focus({ preventScroll: true });
          } else if (!open && wasOpen && mobileMenuDrawer.contains(document.activeElement)) {
            menuToggleBtn.focus({ preventScroll: true });
          }
        };

        if (menuToggleBtn && mobileMenuDrawer) {
          menuToggleBtn.addEventListener('click', () => {
            setMenuOpen(!mobileMenuDrawer.classList.contains('active'));
          });

          mobileMenuDrawer.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => setMenuOpen(false));
          });
        }

        // Header state on scroll: shadow once scrolled; on small screens the
        // header hides while scrolling down and returns on scroll up, leaving
        // only the floating menu button (like quranmajeed.com).
        scrollController?.abort();
        scrollController = new AbortController();
        let lastScrollY = window.scrollY;
        const syncHeader = () => {
          const currentScrollY = window.scrollY;
          const scrolled = currentScrollY > 20;
          const delta = currentScrollY - lastScrollY;
          document.documentElement.classList.toggle('header-scrolled', scrolled);
          if (!scrolled) {
            document.documentElement.classList.remove('header-hidden');
          } else if (Math.abs(delta) > 4) {
            document.documentElement.classList.toggle('header-hidden', delta > 0);
          }
          lastScrollY = currentScrollY;
        };
        syncHeader();
        window.addEventListener('scroll', syncHeader, { passive: true, signal: scrollController.signal });
        window.addEventListener('resize', () => {
          if (window.innerWidth >= 1200) setMenuOpen(false);
        }, { signal: scrollController.signal });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && mobileMenuDrawer?.classList.contains('active')) setMenuOpen(false);
        }, { signal: scrollController.signal });
        // Keyboard focus inside a hidden header brings it back into view.
        siteHeader?.addEventListener('focusin', () => {
          document.documentElement.classList.remove('header-hidden');
        });

        document.querySelectorAll('[data-lang-selector]').forEach(selector => {
          selector.addEventListener('change', (event) => {
            const target = event.currentTarget as HTMLSelectElement;
            navigate(target.value);
          });
        });

        if (newsletterForm instanceof HTMLFormElement && newsletterForm.dataset.ready !== 'true') {
          newsletterForm.dataset.ready = 'true';
          const recaptchaContainer = newsletterForm.querySelector<HTMLElement>('[data-recaptcha]');
          let recaptcha: RecaptchaWidget | undefined;

          // The footer is on every page, so load reCAPTCHA only once the visitor starts filling the form.
          newsletterForm.addEventListener('focusin', () => {
            if (recaptcha || !recaptchaContainer) return;
            recaptchaContainer.hidden = false;
            recaptcha = mountRecaptcha(recaptchaContainer, { sitekey: SENDY_RECAPTCHA_SITE_KEY, theme: 'dark' });
          });

          // Sendy drops requests without a valid token, so block the post until the box is ticked.
          newsletterForm.addEventListener('submit', (e) => {
            if (recaptcha?.hasFailed()) {
              e.preventDefault();
              return;
            }
            if (!recaptcha?.getToken()) {
              e.preventDefault();
              alert(newsletterForm.dataset.recaptchaMsg || 'Please tick "I\'m not a robot" before sending.');
            }
          });
        }
      });
    </script>
