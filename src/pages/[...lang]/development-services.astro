    contactBody: 'تواصل معنا لمناقشة أهداف أعمالك ومتطلبات المؤسسات ومبادرات الذكاء الاصطناعي أو مشاريع البرمجيات المخصصة.',
    email: 'البريد الإلكتروني',
    phone: 'الهاتف',
    location: 'الموقع'
  }
}[lang];

const solutionMeta = [
  { icon: 'psychology-outline', live: true },
  { icon: 'forum-outline', live: true, href: getRelativeLocaleUrl(lang, '/engage-ai') },
  { icon: 'business-center-outline', live: true },
  { icon: 'phone-iphone-outline', live: false }
];
const serviceIcons = ['smartphone-outline', 'code', 'palette-outline', 'settings-outline', 'shield-outline'];
const aboutIcons = ['workspace-premium-outline', 'public', 'verified-outline'];
const valueIcons = ['lightbulb-outline', 'handshake-outline', 'military-tech-outline', 'public'];

const contactEmail = 'support@pakdata.com';
const contactPhone = '+92-21-34559003';
const contactInfo = [
  { icon: 'mail-outline', label: copy.email, value: contactEmail, href: `mailto:${contactEmail}` },
  { icon: 'call-outline', label: copy.phone, value: contactPhone, href: `tel:${contactPhone.replace(/[^+\d]/g, '')}`, ltr: true },
  { icon: 'location-on-outline', label: copy.location, value: t('contact.office.karachi.address') }
];
---

<Layout title={copy.seoTitle} description={copy.seoDesc}>
  <section class="ds-hero">
    <div class="container ds-hero-inner">
      <div class="ds-hero-icons" aria-hidden="true">
        <span><Icon name="material-symbols:smartphone-outline" /></span>
        <span><Icon name="material-symbols:code" /></span>
        <span><Icon name="material-symbols:bolt-outline" /></span>
      </div>
      <h1 class="ds-title">{copy.heroTitle}</h1>
      <p class="ds-lead">{copy.heroLead}</p>
      <div class="ds-cta-row">
        <a href="#portfolio" class="btn btn-primary btn-lg">
          {copy.primaryCta}
          <Icon name="material-symbols:arrow-forward" class="ds-btn-icon ds-arrow" aria-hidden="true" />
        </a>
        <a href="#services" class="btn btn-outline btn-lg">{copy.secondaryCta}</a>
      </div>
      <div class="ds-hero-stats">
        {copy.heroStats.map((stat) => (
          <div class="ds-hero-stat">
            <strong dir="auto">{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="portfolio">
    <div class="container">
      <div class="section-title-wrap">
        <h2 class="section-title">{copy.portfolioTitle}</h2>
        <p class="section-subtitle">{copy.portfolioBody}</p>
      </div>
      <div class="ds-grid-2">
        {copy.solutions.map((item, i) => {
          const meta = solutionMeta[i];
          return (
            <article class:list={['card ds-card', { 'ds-card-accent': !meta.live }]}>
              <div class="ds-card-top">
                <span class="ds-icon-box"><Icon name={`material-symbols:${meta.icon}`} aria-hidden="true" /></span>
                <span class:list={['badge', meta.live ? 'badge-success' : 'ds-badge-dev']}>{meta.live ? copy.live : copy.development}</span>
              </div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <ul class="ds-feature-list">
                {item.features.map((feature) => <li>{feature}</li>)}
              </ul>
              {meta.href && (
                <a href={meta.href} class="btn btn-secondary btn-sm ds-card-btn">
                  {copy.learnMore}
                  <Icon name="material-symbols:open-in-new" class="ds-btn-icon" aria-hidden="true" />
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-bg" id="services">
    <div class="container">
      <div class="section-title-wrap">
        <h2 class="section-title">{copy.servicesTitle}</h2>
        <p class="section-subtitle">{copy.servicesBody}</p>
      </div>
      <div class="ds-grid-3">
        {copy.serviceBlocks.map((service, i) => (
          <article class="card ds-card">
            <span class="ds-icon-box"><Icon name={`material-symbols:${serviceIcons[i]}`} aria-hidden="true" /></span>
            <h3>{service.title}</h3>
            <p>{service.body}</p>
            <div class="ds-tags">
              {service.items.map((item) => <span class="ds-tag">{item}</span>)}
            </div>
          </article>
        ))}
      </div>

      <div class="card ds-cta-card">
        <h3>{copy.ctaTitle}</h3>
        <p>{copy.ctaBody}</p>
        <div class="ds-cta-stats">
          {copy.ctaStats.map((stat) => (
            <div>
              <strong dir="auto">{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
        <a href="#contact" class="btn btn-primary">{copy.cta}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title-wrap">
        <h2 class="section-title">{copy.aboutTitle}</h2>
        <p class="section-subtitle">{copy.aboutBody}</p>
      </div>
      <div class="ds-story">
        <div class="ds-story-copy">
          <h3>{copy.storyTitle}</h3>
          {copy.story.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="ds-story-stats">
          {copy.aboutStats.map((stat, i) => (
            <div class="card ds-stat-card">
              <span class="ds-icon-box"><Icon name={`material-symbols:${aboutIcons[i]}`} aria-hidden="true" /></span>
              <div>
                <strong dir="auto">{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <h3 class="ds-subheading">{copy.valuesTitle}</h3>
      <div class="ds-grid-4">
        {copy.values.map((value, i) => (
          <article class="card ds-value-card">
            <span class="ds-icon-box"><Icon name={`material-symbols:${valueIcons[i]}`} aria-hidden="true" /></span>
            <h4>{value.title}</h4>
            <p>{value.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-bg" id="contact">
    <div class="container">
      <div class="section-title-wrap">
        <h2 class="section-title">{copy.contactTitle}</h2>
        <p class="section-subtitle">{copy.contactBody}</p>
      </div>
      <div class="ds-contact">
        <div class="ds-contact-info">
          {contactInfo.map((info) => (
            <div class="card ds-info-card">
              <span class="ds-icon-box"><Icon name={`material-symbols:${info.icon}`} aria-hidden="true" /></span>
              <div>
                <strong>{info.label}</strong>
                {info.href
                  ? <a href={info.href} dir={info.ltr ? 'ltr' : undefined}>{info.value}</a>
                  : <p>{info.value}</p>}
              </div>
            </div>
          ))}
        </div>

        <div class="card ds-form-card">
          <h3>{t('contact.form.title')}</h3>
          <form class="ds-form" id="ds-contact-form" data-alert-msg={t('contact.form.alert')} data-recaptcha-msg={t('form.recaptcha.required')} data-sending-msg={t('form.sending')} data-rejected-msg={t('form.error.rejected')} data-network-msg={t('form.error.network')}>
            <div class="ds-form-row">
              <div class="form-group">
                <label class="form-label" for="ds-contact-name">{t('contact.form.name.label')}</label>
                <input type="text" id="ds-contact-name" required class="form-control" placeholder={t('contact.form.name.placeholder')} />
              </div>
              <div class="form-group">
                <label class="form-label" for="ds-contact-email">{t('contact.form.email.label')}</label>
                <input type="email" id="ds-contact-email" required class="form-control" placeholder={t('contact.form.email.placeholder')} />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="ds-contact-subject">{t('contact.form.subject.label')}</label>
              <select id="ds-contact-subject" required class="form-control">
                <option value="general">{t('contact.form.subject.opt1')}</option>
                <option value="enterprise">{t('contact.form.subject.opt2')}</option>
                <option value="support">{t('contact.form.subject.opt3')}</option>
                <option value="partnership">{t('contact.form.subject.opt5')}</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="ds-contact-msg">{t('contact.form.msg.label')}</label>
              <textarea id="ds-contact-msg" required class="form-control" placeholder={t('contact.form.msg.placeholder')}></textarea>
            </div>
            <div class="form-trap" aria-hidden="true">
              <label>Leave this field empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <div class="form-recaptcha" data-recaptcha data-failed-msg={t('form.recaptcha.failed')}></div>
            <button type="submit" class="btn btn-primary ds-submit" id="ds-contact-btn">
              {t('contact.form.btn')}
              <Icon name="material-symbols:send-outline" class="ds-btn-icon" aria-hidden="true" />
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { setupMailForm } from '../../lib/mail-service';

  const setupDevelopmentForm = () => {
    const form = document.getElementById('ds-contact-form');
    const button = document.getElementById('ds-contact-btn');
    if (!(form instanceof HTMLFormElement) || !(button instanceof HTMLButtonElement)) return;

    setupMailForm({
      form,
      button,
      fallbackEmail: 'support@pakdata.com',
      buildPayload: () => {
        const subjectSelect = document.getElementById('ds-contact-subject') as HTMLSelectElement;
        const inquiryType = subjectSelect?.selectedOptions[0]?.textContent?.trim() || 'General';
        return {
          name: (document.getElementById('ds-contact-name') as HTMLInputElement)?.value.trim(),
          email: (document.getElementById('ds-contact-email') as HTMLInputElement)?.value.trim(),
          subject: `Development services inquiry: ${inquiryType}`,
          subjectPrefix: 'Pakdata Development Services',
          details: `Inquiry Type: ${inquiryType}`,
          message: (document.getElementById('ds-contact-msg') as HTMLTextAreaElement)?.value.trim(),
        };
      },
      onSuccess: () => alert(form.dataset.alertMsg || 'Message sent!'),
    });
  };

  document.addEventListener('astro:page-load', setupDevelopmentForm);
</script>

<style>
  .ds-hero {
    text-align: center;
    background: radial-gradient(at 20% 0%, oklch(97% .04 60) 0%, transparent 50%), radial-gradient(at 80% 20%, oklch(96% .03 220) 0%, transparent 50%), linear-gradient(180deg, #fefbf8, #fff);
    border-bottom: 1px solid var(--border);
    padding: 5rem 0 4rem;
  }

  .ds-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ds-hero-icons {
    display: flex;
    gap: .75rem;
    margin-bottom: 1.5rem;
  }

  .ds-hero-icons span,
  .ds-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: .75rem;
    background: var(--primary-light);
    color: var(--primary);
    font-size: 1.4rem;
  }

  .ds-hero-icons span {
    border: 1px solid var(--border-focus);
  }

  .ds-title {
    color: var(--dark);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -.02em;
    text-transform: uppercase;
    max-width: 14ch;
    margin-bottom: 1.25rem;
  }

  .ds-lead {
    color: var(--secondary-dark);
    font-size: calc(1.125rem * var(--text-scale, 1));
    line-height: 1.7;
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .ds-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .75rem;
  }

  .ds-btn-icon {
    width: 1.1em;
    height: 1.1em;
    margin-inline-start: .5rem;
  }

  [dir='rtl'] .ds-arrow {
    transform: scaleX(-1);
  }

  .ds-hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    max-width: 40rem;
    margin-top: 3rem;
  }

  .ds-hero-stat {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    padding: 1.1rem .75rem;
    background: rgba(255, 255, 255, .7);
    border: 1px solid var(--border);
    border-radius: 1rem;
  }

  .ds-hero-stat strong,
  .ds-cta-stats strong,
  .ds-stat-card strong {
    color: var(--primary);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .ds-hero-stat span,
  .ds-cta-stats span,
  .ds-stat-card span {
    color: var(--secondary-dark);
    font-size: .85rem;
  }

  .ds-grid-2,
  .ds-grid-3,
  .ds-grid-4 {
    display: grid;
    gap: 1.5rem;
  }

  .ds-grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ds-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ds-grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  .ds-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.75rem;
  }

  .ds-card-accent {
    border-color: var(--border-focus);
    background: linear-gradient(180deg, var(--primary-light), var(--light) 45%);
  }

  .ds-badge-dev {
    background: var(--primary);
    color: var(--light);
  }

  .ds-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
  }

  .ds-card h3 {
    color: var(--dark);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 1.1rem 0 .6rem;
  }

  .ds-card p,
  .ds-value-card p {
    color: var(--secondary-dark);
    line-height: 1.65;
    font-size: .95rem;
  }

  .ds-feature-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: .45rem;
  }

  .ds-feature-list li {
    position: relative;
    padding-inline-start: 1.1rem;
    color: var(--secondary-dark);
    font-size: .9rem;
  }

  .ds-feature-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: .55em;
    width: .4rem;
    height: .4rem;
    border-radius: 50%;
    background: var(--primary);
  }

  .ds-card-btn {
    margin-top: 1.5rem;
    width: 100%;
  }

  .ds-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: 1.1rem;
  }

  .ds-tag {
    padding: .2rem .65rem;
    border-radius: 9999px;
    background: var(--primary-light);
    color: var(--primary);
    font-size: .78rem;
    font-weight: 500;
  }

  .ds-cta-card {
    max-width: 40rem;
    margin: 3rem auto 0;
    text-align: center;
  }

  .ds-cta-card:hover {
    transform: none;
  }

  .ds-cta-card h3 {
    color: var(--dark);
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: .6rem;
  }

  .ds-cta-card > p {
    color: var(--secondary-dark);
    line-height: 1.65;
  }

  .ds-cta-stats {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    margin: 1.5rem 0;
  }

  .ds-cta-stats div {
    display: flex;
    flex-direction: column;
  }

  .ds-story {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .ds-story-copy h3,
  .ds-subheading {
    color: var(--dark);
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .ds-story-copy p {
    color: var(--secondary-dark);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .ds-story-stats,
  .ds-contact-info {
    display: grid;
    gap: 1rem;
  }

  .ds-stat-card,
  .ds-info-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
  }

  .ds-stat-card div,
  .ds-info-card div {
    display: flex;
    flex-direction: column;
  }

  .ds-subheading {
    text-align: center;
    margin: 4rem 0 2rem;
  }

  .ds-value-card {
    text-align: center;
    padding: 1.75rem 1.25rem;
  }

  .ds-value-card h4 {
    color: var(--dark);
    font-size: 1.05rem;
    font-weight: 600;
    margin: 1rem 0 .5rem;
  }

  .ds-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 1.5rem;
    align-items: start;
  }

  .ds-info-card {
    align-items: flex-start;
  }

  .ds-info-card strong {
    color: var(--dark);
    font-weight: 600;
    margin-bottom: .2rem;
  }

  .ds-info-card a,
  .ds-info-card p {
    color: var(--secondary-dark);
    font-size: .92rem;
    line-height: 1.6;
    word-break: break-word;
  }

  .ds-info-card a:hover {
    color: var(--primary);
  }

  .ds-form-card:hover,
  .ds-info-card:hover {
    transform: none;
  }

  .ds-form-card h3 {
    color: var(--dark);
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .ds-submit {
    width: 100%;
  }

  .ds-form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 960px) {
    .ds-grid-3,
    .ds-grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ds-story,
    .ds-contact {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .ds-grid-2,
    .ds-grid-3,
    .ds-grid-4,
    .ds-submit {
    width: 100%;
  }

  .ds-form-row {
      grid-template-columns: 1fr;
    }

    .ds-hero-stats {
      grid-template-columns: 1fr;
      max-width: 20rem;
    }

    .ds-cta-stats {
      gap: 1.5rem;
    }
  }
</style>
