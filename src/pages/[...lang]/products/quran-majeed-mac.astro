---
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'ur' } },
    { params: { lang: 'ar' } }
  ];
}

import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const copy = {
  en: {
    seoTitle: 'Quran Majeed for Mac - Authentic Quran App for Apple Macintosh',
    seoDesc: 'Quran Majeed for Mac offers authentic Quran reading with Uthmanic script, complete Surah Al-Baqarah, audio recitations, and translations on Apple Macintosh.',
    title: 'Quran Majeed for Mac OS',
    lead: 'Quran Majeed is an amazing Quran app that beautifies your life with the blessing of reading and listening to the Quran on your Mac.',
    body: 'The latest version of the authentic Quran Majeed app for Apple Macintosh offers complete Surah Al-Baqarah in the elegant Uthmanic script proofread by a Muslim scholar, multiple audio recitations, and translations.',
    footerDesc: 'Quran Majeed for Mac offers authentic Quran reading with Uthmanic script, complete Surah Al-Baqarah, audio recitations, and translations on Apple Macintosh.'
  },
  ur: {
    seoTitle: 'قرآن مجید برائے میک - ایپل میکنٹوش کے لیے مستند قرآن ایپ',
    seoDesc: 'قرآن مجید برائے میک مستند قرآنی مطالعہ فراہم کرتا ہے جس میں عثمانی رسم الخط، مکمل سورہ البقرہ، آڈیو تلاوتیں اور تراجم شامل ہیں۔',
    title: 'قرآن مجید برائے میک',
    lead: 'قرآن مجید ایک خوبصورت قرآن ایپ ہے جو آپ کی زندگی کو اپنے میک پر قرآن پڑھنے اور سننے کی برکت سے مزین کرتی ہے۔',
    body: 'ایپل میکنٹوش کے لیے قرآن مجید کا جدید ترین ورژن مکمل سورۃ البقرہ کو خوبصورت عثمانی رسم الخط میں پیش کرتا ہے، جس کی پروف ریڈنگ ایک مسلمان عالم نے کی ہے، ساتھ میں متعدد آڈیو تلاوتیں اور تراجم بھی شامل ہیں۔',
    footerDesc: 'قرآن مجید برائے میک ایپل میکنٹوش پر مستند قرآنی مطالعہ، عثمانی رسم الخط، مکمل سورہ البقرہ، آڈیو تلاوتیں اور تراجم فراہم کرتا ہے۔'
  },
  ar: {
    seoTitle: 'القرآن المجيد للماك - تطبيق قرآن أصيل لأجهزة Apple Macintosh',
    seoDesc: 'يوفر القرآن المجيد للماك قراءة قرآنية أصيلة بخط عثماني، وسورة البقرة كاملة، وتلاوات صوتية وترجمات على Apple Macintosh.',
    title: 'القرآن المجيد للماك',
    lead: 'القرآن المجيد هو تطبيق قرآن رائع يجمّل حياتك بنعمة قراءة القرآن والاستماع إليه على جهاز الماك.',
    body: 'يوفر أحدث إصدار من تطبيق القرآن المجيد الأصيل لأجهزة Apple Macintosh سورة البقرة كاملة بالخط العثماني الأنيق، تمت مراجعته من قبل عالم مسلم، مع تلاوات صوتية متعددة وترجمات لتجربة قرآنية مكتبية راقية.',
    footerDesc: 'يوفر القرآن المجيد للماك قراءة قرآنية أصيلة بخط عثماني، وسورة البقرة كاملة، وتلاوات صوتية وترجمات على Apple Macintosh.'
  }
}[lang];
---

<Layout title={copy.seoTitle} description={copy.seoDesc}>
  <section class="mac-hero">
    <div class="container mac-grid">
      <div class="mac-copy">
        <h1 class="mac-title">{copy.title}</h1>
        <p class="mac-lead">{copy.lead}</p>
        <p class="mac-body">{copy.body}</p>
      </div>

      <div class="mac-visual card">
        <div class="mac-frame">
          <img src="/images/qm-mac.png" alt="Apple Macintosh product visual" class="mac-device" />
          <img src="/images/Mac.png" alt="Quran Majeed Mac app screenshot" class="mac-screen" />
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .mac-hero {
    background: radial-gradient(at 20% 0%, oklch(97% .04 60) 0%, transparent 50%), radial-gradient(at 80% 20%, oklch(96% .03 220) 0%, transparent 50%), linear-gradient(180deg, #fefbf8, #fff);
    border-bottom: 1px solid var(--border);
    padding: 4.5rem 0 4rem;
  }

  .mac-grid,
  .split-layout {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 2rem;
    align-items: center;
  }

  .split-layout.reverse {
    grid-template-columns: .95fr 1.05fr;
  }

  .mac-title {
    font-size: clamp(1.8rem, 2.5vw, 3rem);
    line-height: 1.05;
    font-weight: 700;
    color: var(--primary);
    margin: .9rem 0 1rem;
    letter-spacing: -0.01em;
  }

  .mac-lead,
  .mac-body,
  .body-copy {
    color: var(--secondary-dark);
    line-height: 1.7;
    font-size: calc(1.02rem * var(--text-scale, 1));
  }

  .mac-body {
    margin-top: .9rem;
  }

  .mac-visual {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 1.2rem;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .mac-visual {
    padding: 1rem;
  }

  .mac-frame {
    position: relative;
    min-height: 28rem;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, rgba(255,255,255,.8), rgba(255,255,255,.96));
    border-radius: 1rem;
    overflow: hidden;
  }

  .mac-device {
    display: block;
    width: min(100%, 34rem);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 25px 40px rgba(15,23,42,.12));
  }

  .mac-screen {
    position: absolute;
    width: min(46%, 18rem);
    height: auto;
    object-fit: contain;
    right: 8%;
    bottom: 8%;
    border-radius: 1rem;
    box-shadow: 0 20px 40px rgba(15,23,42,.16);
    border: 1px solid rgba(15,23,42,.08);
    background: #fff;
  }

  .visual-only {
    display: grid;
    place-items: center;
  }

  .visual-stack {
    position: relative;
    min-height: 28rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 1.2rem;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .stack-shot {
    position: absolute;
    width: 68%;
    left: 8%;
    top: 10%;
    border-radius: 1rem;
    box-shadow: 0 20px 40px rgba(15,23,42,.16);
    border: 1px solid rgba(15,23,42,.08);
    background: #fff;
  }

  .stack-frame {
    position: absolute;
    width: 52%;
    right: 6%;
    bottom: 8%;
    border-radius: 1rem;
    box-shadow: 0 20px 40px rgba(15,23,42,.14);
    border: 1px solid rgba(15,23,42,.08);
    background: #fff;
  }

  @media (max-width: 1024px) {
    .mac-grid,
    .split-layout,
    .split-layout.reverse {
      grid-template-columns: 1fr;
    }

    .mac-frame,
    .visual-stack {
      min-height: 22rem;
    }
  }

  @media (max-width: 640px) {
    .mac-hero {
      padding: 3.5rem 0 3rem;
    }

    .mac-title {
      max-width: none;
    }
    .mac-screen {
      width: 56%;
    }

    .stack-shot {
      width: 74%;
      left: 4%;
    }

    .stack-frame {
      width: 58%;
      right: 4%;
    }
  }
</style>
