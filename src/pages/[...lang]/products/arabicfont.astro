---
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'ur' } },
    { params: { lang: 'ar' } }
  ];
}

import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const copy = {
  en: {
    seoTitle: 'PDMS Saleem Quran Font | Arabic Font for Holy Quran by Pakdata',
    seoDesc: 'Discover PDMS Saleem Quran Font, a high quality OpenType Arabic font for the Holy Quran based on Unicode, with advanced aeraab support, waqf symbols, and Quranic calligraphy styling.',
    heroTitle: 'Arabic Font for Holy Quran',
    heroLead: 'A high quality OpenType font for Holy Quran text based on Unicode standard with refined glyphs, proper aeraab placement, and waqf symbols for clear Quranic reading.',
    overviewTitle: 'Project Overview',
    overviewBody: 'Pakistan Data Management Services is pleased to announce the release of an OpenType font for writing Holy Quran text based on the Unicode standard. The font features high quality glyphs and support for all aeraabs and mark placements at proper positions. All waqfs used to identify different pauses in reading are also provided. PDMS Saleem Quran Font provides advanced Arabic typography close to calligraphy while retaining the beauty and legibility of Quran Majeed Arabic text.',
    craftTitle: 'Calligraphy Rooted in Quranic Tradition',
    craftBody: 'The font is developed according to the rules used in Quranic calligraphy in Pakistan, following the style of Yameen Dehlvi, one of the finest Quran calligraphers in Pakistan. Guidance and calligraphy of basic glyphs for the font have been provided by Mr. Mohammed Saleem, who is inspired by the work of Shafiq-uz-Zaman and frequently consults him for guidance.',
    typographyTitle: 'Advanced Arabic Typography',
    typographyBody: 'We are confident that ‘PDMS Saleem Quran Font’ will appeal to all Arabic users, especially designers and publishers who will no longer be bound by the technological limitations of old Quran printing methods.',
    footerDesc: 'PDMS Saleem Quran Font is a high quality Arabic OpenType font for Holy Quran text with advanced aeraab support, waqf symbols, and Quranic calligraphy styling.'
  },
  ur: {
    seoTitle: 'پی ڈی ایم ایس سلیم قرآن فونٹ | پاک ڈیٹا کا عربی قرآن فونٹ',
    seoDesc: 'PDMS Saleem Quran Font دریافت کریں، ایک اعلیٰ معیار کا OpenType عربی فونٹ جو قرآنِ مجید کے لیے Unicode بنیاد، بہتر اعراب سپورٹ، وقف علامات اور قرآنی خطاطی اسٹائل کے ساتھ تیار کیا گیا ہے۔',
    heroTitle: 'قرآنِ مجید کے لیے عربی فونٹ',
    heroLead: 'قرآنِ مجید کے متن کے لیے اعلیٰ معیار کا OpenType فونٹ، جو Unicode معیار پر مبنی ہے، بہتر glyphs، درست اعراب، اور وقف علامات کے ساتھ واضح قرآنی مطالعے کے لیے بنایا گیا ہے۔',
    overviewTitle: 'منصوبے کا جائزہ',
    overviewBody: 'پاکستان ڈیٹا مینجمنٹ سروسز Unicode معیار پر مبنی قرآنِ مجید کے متن کے لیے OpenType فونٹ پیش کرنے پر خوش ہے۔ اس فونٹ میں اعلیٰ معیار کے glyphs، تمام اعراب کی درست جگہوں پر سپورٹ، اور قراءت میں وقف کی نشاندہی کے لیے تمام waqf علامات شامل ہیں۔ PDMS Saleem Quran Font خطاطی کے قریب جدید عربی ٹائپوگرافی فراہم کرتا ہے جبکہ قرآنِ مجید کے متن کی خوبصورتی اور خواندگی برقرار رکھتا ہے۔',
    craftTitle: 'قرآنی خطاطی کی روایت سے جڑا فن',
    craftBody: 'یہ فونٹ پاکستان میں رائج قرآنی خطاطی کے اصولوں کے مطابق تیار کیا گیا ہے اور یامین دہلوی کے اسلوب کی پیروی کرتا ہے، جو پاکستان کے بہترین قرآن خطاطوں میں شمار ہوتے ہیں۔ فونٹ کے بنیادی glyphs کی رہنمائی اور خطاطی محمد سلیم نے فراہم کی، جو شفیق الزمان کے کام سے متاثر ہیں اور اکثر ان سے رہنمائی لیتے ہیں۔',
    typographyTitle: 'جدید عربی ٹائپوگرافی',
