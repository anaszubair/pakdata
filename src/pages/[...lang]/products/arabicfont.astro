    overviewTitle: 'نظرة عامة على المشروع',
    overviewBody: 'يسر شركة باكستان داتا مانجمنت سيرفيسز أن تعلن عن إصدار خط OpenType لكتابة نص القرآن الكريم مبني على معيار Unicode. يتميز الخط بوجود رموز عالية الجودة ودعم لجميع الحركات/العلامات في مواضعها الصحيحة. كما يوفر جميع علامات الوقف المستخدمة لتحديد التوقفات المختلفة أثناء القراءة. يقدم PDMS Saleem Quran Font طباعة عربية متقدمة قريبة من الخط اليدوي مع الحفاظ على جمال وسهولة قراءة نص القرآن الكريم.',
    craftTitle: 'خط متجذر في تقاليد الخط القرآني',
    craftBody: 'تم تطوير الخط وفق القواعد المستخدمة في الخط القرآني في باكستان، على أسلوب يامين دهلوي، أحد أفضل خطاطي القرآن في باكستان. وقد قُدمت الإرشادات والخط اليدوي للرموز الأساسية للخط من قبل السيد محمد سليم، وهو من طلاب محمد إقبال سعيد ويامين دهلوي وشفيق الزمان. كما يستلهم محمد سليم من أعمال شفيق الزمان ويستشيره كثيرًا.',
    typographyTitle: 'طباعة عربية متقدمة',
    typographyBody: 'We are confident that ‘PDMS Saleem Quran Font’ will appeal to all Arabic users, especially designers and publishers who will no longer be bound by the technological limitations of old Quran printing methods.',
    footerDesc: 'PDMS Saleem Quran Font هو خط عربي OpenType عالي الجودة لنص القرآن الكريم مع دعم متقدم للحركات وعلامات الوقف وأسلوب الخط القرآني.'
  }
}[lang];
---

<Layout title={copy.seoTitle} description={copy.seoDesc}>
  <section class="font-hero">
    <div class="container font-grid">
      <div class="font-copy">
        <h1 class="font-title">{copy.heroTitle}</h1>
        <p class="font-lead">{copy.heroLead}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-layout">
      <div class="section-copy-block">
        <span class="badge badge-primary">{copy.overviewTitle}</span>
        <h2 class="section-title">{copy.overviewTitle}</h2>
        <p class="body-copy">{copy.overviewBody}</p>
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container split-layout reverse">
      <div class="section-copy-block">
        <span class="badge badge-primary">{copy.craftTitle}</span>
        <h2 class="section-title">{copy.craftTitle}</h2>
        <p class="body-copy">{copy.craftBody}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title-wrap tight">
        <span class="badge badge-primary">{copy.typographyTitle}</span>
        <h2 class="section-title">{copy.typographyTitle}</h2>
      </div>
      <p class="body-copy section-copy">{copy.typographyBody}</p>
    </div>
  </section>
</Layout>

<style>
  .font-hero {
    background: radial-gradient(at 20% 0%, oklch(97% .04 60) 0%, transparent 50%), radial-gradient(at 80% 20%, oklch(96% .03 220) 0%, transparent 50%), linear-gradient(180deg, #fefbf8, #fff);
    border-bottom: 1px solid var(--border);
    padding: 4.5rem 0 4rem;
  }

  .font-grid,
  .split-layout {
    display: grid;
    grid-template-columns: minmax(0, 52rem);
    justify-content: center;
    gap: 2rem;
    align-items: center;
    text-align: center;
  }

  .font-hero .container,
  .section .container,
  .font-copy,
  .section-title-wrap,
  .section-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .split-layout.reverse {
    grid-template-columns: minmax(0, 52rem);
  }

  .font-title {
    font-size: clamp(1.8rem, 2.5vw, 3rem);
    line-height: 1.05;
    font-weight: 700;
    color: var(--primary);
    margin: .9rem 0 1rem;
    letter-spacing: -0.01em;
  }

  .font-lead,
  .body-copy {
    color: var(--secondary-dark);
    line-height: 1.7;
    font-size: calc(1.02rem * var(--text-scale, 1));
    max-width: 52rem;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .section-title {
    font-size: clamp(1.65rem, 2.8vw, 2.65rem);
    line-height: 1.12;
    margin: .7rem 0 .9rem;
    color: var(--dark);
  }

  .section-copy-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  .section-title-wrap.tight {
    margin-bottom: 1.3rem;
  }

  .section-copy {
    max-width: 52rem;
  }

  @media (max-width: 1024px) {
    .font-grid,
    .split-layout,
    .split-layout.reverse {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .font-hero {
      padding: 3.5rem 0 3rem;
    }

    .font-title {
      max-width: none;
    }

  }
</style>
