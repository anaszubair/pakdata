}[lang];
---

<Layout title={copy.seoTitle} description={copy.seoDesc}>
  <section class="role-hero">
    <div class="container role-hero-grid">
      <div>
        <span class="badge badge-primary">{copy.badge}</span>
        <h1 class="role-title">{copy.title}</h1>
        <p class="role-intro">{copy.intro}</p>
        <p class="role-body">{copy.body}</p>
        <div class="role-actions">
          <a href={getRelativeLocaleUrl(lang, '/job-us')} class="btn btn-outline btn-lg">{copy.back}</a>
          <a href="mailto:careers@pakdata.com?subject=Motion%20Graphic%20Designer" class="btn btn-primary btn-lg">{copy.apply}</a>
        </div>
      </div>
      <div class="role-panel card">
        <span class="panel-label">{copy.sectionTitle}</span>
        <ul class="detail-list">
          {copy.details.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container role-cta card">
      <div>
        <span class="badge badge-primary">{copy.badge}</span>
        <h2 class="section-title">{copy.ctaTitle}</h2>
        <p class="body-copy">{copy.ctaBody}</p>
      </div>
      <a href="mailto:careers@pakdata.com?subject=Motion%20Graphic%20Designer" class="btn btn-primary btn-lg">careers@pakdata.com</a>
    </div>
  </section>
</Layout>

<style>
  .role-hero {
    background: radial-gradient(at 20% 0%, oklch(97% .04 60) 0%, transparent 50%), radial-gradient(at 80% 20%, oklch(96% .03 220) 0%, transparent 50%), linear-gradient(180deg, #fefbf8, #fff);
    border-bottom: 1px solid var(--border);
    padding: 4.5rem 0 3.5rem;
  }

  .role-hero-grid,
  .role-cta {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .role-hero-grid {
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr);
  }

  .role-title {
    color: var(--primary);
    font-size: clamp(2.2rem, 3vw, 3rem);
    line-height: 1.04;
    margin: .85rem 0 1rem;
  }

  .role-intro {
    color: var(--dark);
    font-weight: 700;
    line-height: 1.65;
    margin-bottom: .9rem;
  }

  .role-body,
  .body-copy {
    color: var(--secondary-dark);
    line-height: 1.7;
  }

  .role-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 1.2rem;
  }

  .role-panel,
  .role-cta {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    padding: 1.25rem;
  }

  .panel-label {
    display: block;
    margin-bottom: .9rem;
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .detail-list {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: .7rem;
    color: var(--secondary-dark);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .role-hero-grid,
    .role-cta {
      grid-template-columns: 1fr;
    }
  }
</style>
