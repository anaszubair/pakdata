---
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'ur' } },
    { params: { lang: 'ar' } }
  ];
}

import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const copy = {
  en: {
    title: 'Quran Majeed Certificates',
    description: 'View the official certificates verifying the accuracy of the Arabic text, Indo-Pak script and English translations in the Quran Majeed app by PDMS.',
    alts: [
      'Quran Majeed certificate for English Dr Mohsin',
      'Quran Majeed certificate for English Pickthal',
      'Quran Majeed certificate for English Abdullah Yousuf',
      'Quran Majeed Arabic text correctness certificate',
      'Quran Majeed Indo-Pak script certificate'
    ]
  },
  ur: {
    title: 'قرآن مجید سرٹیفکیٹس',
    description: 'PDMS کی قرآن مجید ایپ میں عربی متن، انڈو پاک رسم الخط اور انگریزی تراجم کی درستگی کی تصدیق کرنے والے سرکاری سرٹیفکیٹس دیکھیں۔',
    alts: [
      'انگریزی ترجمہ ڈاکٹر محسن کے لیے قرآن مجید سرٹیفکیٹ',
      'انگریزی ترجمہ پکتھال کے لیے قرآن مجید سرٹیفکیٹ',
      'انگریزی ترجمہ عبداللہ یوسف کے لیے قرآن مجید سرٹیفکیٹ',
      'قرآن مجید عربی متن کی درستگی کا سرٹیفکیٹ',
      'قرآن مجید انڈو پاک رسم الخط سرٹیفکیٹ'
    ]
  },
  ar: {
    title: 'شهادات القرآن المجيد',
    description: 'اطّلع على الشهادات الرسمية التي تؤكد دقة النص العربي والرسم الهندي الباكستاني والترجمات الإنجليزية في تطبيق القرآن المجيد من PDMS.',
    alts: [
      'شهادة القرآن المجيد للترجمة الإنجليزية للدكتور محسن',
      'شهادة القرآن المجيد للترجمة الإنجليزية لبكثال',
      'شهادة القرآن المجيد للترجمة الإنجليزية لعبد الله يوسف',
      'شهادة صحة النص العربي في القرآن المجيد',
      'شهادة الرسم الهندي الباكستاني في القرآن المجيد'
    ]
  }
}[lang] ?? {
  title: 'Quran Majeed Certificates',
  description: 'View the official certificates verifying the accuracy of the Arabic text, Indo-Pak script and English translations in the Quran Majeed app by PDMS.',
  alts: [] as string[]
};

const certificateFiles = [
  { src: '/images/certificates/QuranEngDrMohsinCertificate.gif', width: 1202, height: 1698, alt: 'Quran Majeed certificate for English Dr Mohsin' },
  { src: '/images/certificates/QuranEngPickthalCertificate.gif', width: 1279, height: 1686, alt: 'Quran Majeed certificate for English Pickthal' },
  { src: '/images/certificates/QuranEngAbdullahYousufCertificate.gif', width: 1287, height: 1706, alt: 'Quran Majeed certificate for English Abdullah Yousuf' },
  { src: '/images/certificates/QuranArabicTextCorrectCertificate.gif', width: 1162, height: 1659, alt: 'Quran Majeed Arabic text correctness certificate' },
  { src: '/images/certificates/Indopak-Certificate.gif', width: 1214, height: 1609, alt: 'Quran Majeed Indo-Pak script certificate' }
];

const certificates = certificateFiles.map((file, index) => ({
  ...file,
  alt: copy.alts[index] ?? file.alt
}));
---

<Layout title={copy.title} description={copy.description}>
  <section class="certs-page" aria-labelledby="certs-title">
    <div class="container">
      <h1 class="certs-title" id="certs-title">{copy.title}</h1>
    </div>
    <div class="container certs-grid">
      {certificates.map((certificate, index) => (
        <figure class="cert-card card">
          <img
            src={certificate.src}
            alt={certificate.alt}
            class="cert-image"
            width={certificate.width}
            height={certificate.height}
            loading={index < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </figure>
      ))}
    </div>
  </section>
</Layout>

<style>
  .certs-page {
    padding: 1.25rem 0 2rem;
    background: #fff;
  }

  .certs-title {
    color: var(--primary);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
    margin: 0.75rem 0 1.25rem;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .cert-card {
    margin: 0;
    padding: .75rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: #fff;
    box-shadow: var(--shadow-sm);
  }

  .cert-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: .6rem;
    object-fit: contain;
  }

  @media (max-width: 720px) {
    .certs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
