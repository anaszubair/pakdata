      { p: 'By emailing to our DPO: support@pakdata.com' },
      { p: 'By visiting this page on our website: www.pakdata.com' },
      { p: 'By phone number: +92-21-34559003' },
      { p: 'By post: Pakistan Data Management Services, NASTP-2 Silicon Valley-2, Building S2, 1st Floor, Office No.15, Main Shahrah-e-Faisal, Karachi, Pakistan' }
