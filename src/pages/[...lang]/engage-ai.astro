---

<Layout title={copy.seoTitle} description={copy.seoDesc}>
  <section class="engage-hero">
    <div class="container engage-hero-grid">
      <div class="engage-copy">
        <h1 class="engage-title">{copy.heroTitle}</h1>
        <p class="engage-lead">{copy.heroLead}</p>
        <p class="engage-body">{copy.heroBody}</p>
        <div class="engage-cta-row">
          <a href={getRelativeLocaleUrl(lang, '/contact-us')} class="btn btn-primary btn-lg">{copy.contactCta}</a>
          <a href={getRelativeLocaleUrl(lang, '/contact-us')} class="btn btn-outline btn-lg">{copy.scheduleCta}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split-copy">
        <h2 class="section-title">{copy.problemTitle}</h2>
        <p class="body-copy">{copy.problemBody}</p>
        <p class="body-copy">{copy.problemBody2}</p>
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-title-wrap tight">
        <h2 class="section-title">{copy.featuresTitle}</h2>
      </div>
      <div class="feature-grid">
        {copy.features.map((feature) => (
          <article class="feature-card card">
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title-wrap tight">
        <h2 class="section-title">{copy.industriesTitle}</h2>
        <p class="body-copy">{copy.industriesBody}</p>
        <div class="chip-grid">
          {copy.industries.map((item) => <span class="chip">{item}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-title-wrap tight">
        <h2 class="section-title">{copy.benefitsTitle}</h2>
      </div>
      <div class="usecase-grid">
        {copy.benefits.map((item) => (
          <article class="usecase-card card">
            <h3>{item}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title-wrap tight">
        <h2 class="section-title">{copy.useCasesTitle}</h2>
      </div>
      <div class="usecase-grid">
        {copy.useCases.map((item) => (
          <article class="usecase-card card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="split-copy security-copy">
        <h2 class="section-title">{copy.securityTitle}</h2>
        <p class="body-copy">{copy.securityBody}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-card card">
        <h2 class="section-title">{copy.ctaTitle}</h2>
        <p class="body-copy">{copy.ctaBody}</p>
        <h3>{copy.getStartedTitle}</h3>
        <p class="body-copy">{copy.getStartedBody}</p>
        <a href={getRelativeLocaleUrl(lang, '/contact-us')} class="btn btn-primary">{copy.contactCta}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .engage-hero {
    background: radial-gradient(at 20% 0%, oklch(97% .04 60) 0%, transparent 50%), radial-gradient(at 80% 20%, oklch(96% .03 220) 0%, transparent 50%), linear-gradient(180deg, #fefbf8, #fff);
    color: var(--dark);
    padding: 4.5rem 0 3.5rem;
    border-bottom: 1px solid var(--border);
  }

  .engage-hero-grid,
  .split-grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .engage-hero-grid {
    grid-template-columns: minmax(0, 52rem);
    justify-content: center;
    text-align: center;
  }

  .engage-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .engage-copy .badge,
  .engage-copy .engage-lead,
  .engage-copy .engage-body,
  .engage-title,
  .section-title,
  .body-copy,
  .split-copy,
  .cta-card,
  .contact-card,
  .benefit-card,
  .enterprise-card,
  .security-stack {
    letter-spacing: 0;
  }

  .engage-title {
    margin: .85rem 0 .85rem;
    font-size: clamp(2.2rem, 3vw, 3rem);
    line-height: 1.02;
    color: var(--primary);
  }

  .engage-lead {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    font-weight: 700;
    color: var(--dark);
    margin-bottom: .9rem;
  }

  .engage-body {
    color: var(--secondary-dark);
    line-height: 1.7;
    max-width: 46rem;
    margin-bottom: .8rem;
  }

  .engage-cta-row,
  .trust-pills,
  .chip-grid,
  .benefit-list {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
  }

  .engage-cta-row {
    justify-content: center;
  }

  .trust-bar {
    margin-top: 1.75rem;
