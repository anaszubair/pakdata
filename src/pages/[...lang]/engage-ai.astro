  problemBody: 'Modern customers expect instant responses, seamless interactions, and personalized service. EngageAI empowers your organization with a smart virtual assistant that engages visitors, answers questions, captures leads, and provides support around the clock.',
  problemBody2: 'Whether you\'re serving customers, supporting employees, or generating leads, EngageAI helps you deliver exceptional experiences at scale.',
  featuresTitle: 'Key Features',
  features: [
    { title: 'Intelligent Conversations', body: 'Leverage advanced natural language processing to understand customer queries and respond accurately in real time.' },
    { title: '24/7 Availability', body: 'Provide uninterrupted support and engagement, ensuring your customers always receive timely assistance.' },
    { title: 'Seamless Integration', body: 'Easily integrate with your website, CRM, ERP, and other business systems.' },
    { title: 'Lead Generation & Qualification', body: 'Automatically capture, qualify, and route leads to your sales team.' },
    { title: 'Multilingual Support', body: 'Engage customers in multiple languages to expand your reach and improve accessibility.' },
    { title: 'Analytics & Insights', body: 'Gain actionable intelligence through detailed conversation analytics and performance dashboards.' },
    { title: 'Secure & Scalable', body: 'Built with enterprise-grade security and designed to scale with your business.' }
  ],
  industriesTitle: 'Solutions for Every Industry',
  industriesBody: 'EngageAI adapts to your unique business needs across industries, including:',
  industries: ['Banking & Financial Services', 'Healthcare', 'Education', 'E-Commerce', 'Telecommunications', 'Government', 'Real Estate', 'Hospitality'],
  benefitsTitle: 'Why Choose EngageAI?',
  benefits: [
    'Improve customer satisfaction',
    'Reduce operational costs',
    'Increase conversion rates',
    'Accelerate response times',
    'Automate repetitive tasks',
    'Enhance team productivity'
  ],
  useCasesTitle: 'Use Cases',
  useCases: [
    { title: 'Customer Support', body: 'Resolve customer inquiries instantly and reduce support workload.' },
    { title: 'Sales Assistance', body: 'Guide prospects, recommend products, and boost conversions.' },
    { title: 'Lead Capture', body: 'Identify high-intent visitors and collect valuable customer information.' },
    { title: 'Internal Helpdesk', body: 'Support employees with HR, IT, and operational queries.' }
  ],
  securityTitle: 'Enterprise-Ready Security',
  securityBody: 'Your data security is our priority. EngageAI is built with robust security protocols, ensuring compliance, confidentiality, and peace of mind.',
  ctaTitle: 'Ready to Transform Your Customer Engagement?',
  ctaBody: 'Unlock the power of conversational AI and elevate your customer experience with EngageAI by PakData.',
  getStartedTitle: 'Get Started Today',
  getStartedBody: 'Schedule a demo and discover how EngageAI can help your business grow.',
  contactCta: 'Contact Us',
  scheduleCta: 'Schedule a Demo'
};
---

<Layout title={copy.seoTitle} description={copy.seoDesc}>
  <section class="engage-hero">
    <div class="container engage-hero-grid">
      <div class="engage-copy">
        <h1 class="engage-title">{copy.heroTitle}</h1>
        <p class="engage-lead">{copy.heroLead}</p>
        <p class="engage-body">{copy.heroBody}</p>
        <div class="engage-cta-row">
          <a href={getRelativeLocaleUrl(lang, '/contact-us')} class="btn btn-primary btn-lg">{copy.contactCta}</a>
          <a href={getRelativeLocaleUrl(lang, '/contact-us')} class="btn btn-outline btn-lg">{copy.scheduleCta}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split-copy">
        <h2 class="section-title">{copy.problemTitle}</h2>
        <p class="body-copy">{copy.problemBody}</p>
        <p class="body-copy">{copy.problemBody2}</p>
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-title-wrap tight">
        <h2 class="section-title">{copy.featuresTitle}</h2>
      </div>
      <div class="feature-grid">
        {copy.features.map((feature) => (
          <article class="feature-card card">
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title-wrap tight">
        <h2 class="section-title">{copy.industriesTitle}</h2>
        <p class="body-copy">{copy.industriesBody}</p>
        <div class="chip-grid">
          {copy.industries.map((item) => <span class="chip">{item}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="section-title-wrap tight">
        <h2 class="section-title">{copy.benefitsTitle}</h2>
      </div>
      <div class="usecase-grid">
        {copy.benefits.map((item) => (
          <article class="usecase-card card">
            <h3>{item}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title-wrap tight">
        <h2 class="section-title">{copy.useCasesTitle}</h2>
      </div>
      <div class="usecase-grid">
        {copy.useCases.map((item) => (
          <article class="usecase-card card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container">
      <div class="split-copy security-copy">
        <h2 class="section-title">{copy.securityTitle}</h2>
        <p class="body-copy">{copy.securityBody}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-card card">
        <h2 class="section-title">{copy.ctaTitle}</h2>
        <p class="body-copy">{copy.ctaBody}</p>
        <h3>{copy.getStartedTitle}</h3>
        <p class="body-copy">{copy.getStartedBody}</p>
        <a href={getRelativeLocaleUrl(lang, '/contact-us')} class="btn btn-primary">{copy.contactCta}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .engage-hero {
    background: radial-gradient(at 20% 0%, oklch(97% .04 60) 0%, transparent 50%), radial-gradient(at 80% 20%, oklch(96% .03 220) 0%, transparent 50%), linear-gradient(180deg, #fefbf8, #fff);
    color: var(--dark);
    padding: 4.5rem 0 3.5rem;
    border-bottom: 1px solid var(--border);
  }

  .engage-hero-grid,
  .split-grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .engage-hero-grid {
    grid-template-columns: minmax(0, 52rem);
    justify-content: center;
    text-align: center;
  }

  .engage-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .engage-copy .badge,
  .engage-copy .engage-lead,
  .engage-copy .engage-body,
  .engage-title,
  .section-title,
  .body-copy,
  .split-copy,
  .cta-card,
  .contact-card,
  .benefit-card,
  .enterprise-card,
  .security-stack {
    letter-spacing: 0;
  }

  .engage-title {
    margin: .85rem 0 .85rem;
    font-size: clamp(2.2rem, 3vw, 3rem);
    line-height: 1.02;
    color: var(--primary);
  }

  .engage-lead {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    font-weight: 700;
    color: var(--dark);
    margin-bottom: .9rem;
  }

  .engage-body {
    color: var(--secondary-dark);
    line-height: 1.7;
    max-width: 46rem;
    margin-bottom: .8rem;
  }

  .engage-cta-row,
  .trust-pills,
  .chip-grid,
  .benefit-list {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
  }

  .engage-cta-row {
    justify-content: center;
  }

  .trust-bar {
    margin-top: 1.75rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .trust-label {
    text-transform: uppercase;
    font-size: .78rem;
    letter-spacing: .08em;
    color: var(--secondary-dark);
    font-weight: 700;
  }

  .trust-pill,
  .chip,
  .panel-pill,
  .dash-card,
  .flow-node,
  .stack-row,
  .benefit-item {
    border-radius: 999px;
    padding: .65rem .9rem;
    background: rgba(255,255,255,.96);
    border: 1px solid var(--border);
    color: var(--dark);
    font-weight: 600;
  }

  .engage-shell {
    display: flex;
    justify-content: center;
  }

  .engage-panel {
    width: min(100%, 31rem);
    padding: 1.25rem;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }

  .engage-panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--dark);
    margin-bottom: 1rem;
  }

  .panel-pill {
    background: var(--primary-light);
    border-color: rgba(249,115,22,.2);
    color: var(--primary);
  }

  .engage-dashboard {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
    margin-bottom: 1rem;
  }

  .dash-card {
    border-radius: 1rem;
    min-height: 5.2rem;
    display: grid;
    place-items: center;
    text-align: center;
    background: var(--light-soft);
  }

  .engage-flow {
    display: grid;
    gap: .75rem;
  }

  .flow-node {
    border-radius: .9rem;
    text-align: center;
  }

  .split-grid {
    grid-template-columns: minmax(0, 1.05fr) minmax(260px, .95fr);
  }

  .dark-split .enterprise-card,
  .cta-card,
  .contact-card,
  .benefit-card,
  .security-stack {
    background: #fff;
    color: var(--dark);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .enterprise-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
  }

  .enterprise-grid div {
    min-height: 5rem;
    display: grid;
    place-items: center;
    padding: 1rem;
    border-radius: .9rem;
    background: linear-gradient(180deg, #fff, #f8fafc);
    color: var(--dark);
    font-weight: 600;
  }

  .feature-grid,
  .usecase-grid,
  .benefit-grid,
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .feature-card,
  .usecase-card,
  .benefit-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.1rem;
    box-shadow: var(--shadow-sm);
  }

  .feature-card h3,
  .usecase-card h3,
  .benefit-card h3,
  .cta-card h3 {
    margin-bottom: .55rem;
    font-size: 1.02rem;
  }

  .feature-card p,
  .usecase-card p,
  .benefit-card p,
  .cta-card p,
  .contact-card p,
  .security-stack,
  .faq-item p {
    color: var(--secondary-dark);
    line-height: 1.6;
  }

  .check-list {
    list-style: none;
    margin: .75rem 0 1rem;
    padding: 0;
    display: grid;
    gap: .55rem;
  }

  .check-list li {
    position: relative;
    padding-inline-start: 1.25rem;
    color: var(--secondary-dark);
    line-height: 1.55;
  }

  .check-list li::before {
    content: '•';
    position: absolute;
    inset-inline-start: 0;
    color: var(--primary);
    font-size: 1.2rem;
    line-height: 1;
  }

  .security-stack {
    display: grid;
    gap: .75rem;
  }

  .stack-row {
    color: var(--dark);
    background: var(--light-soft);
    border-color: var(--border);
    border-radius: .8rem;
    text-align: center;
  }

  .faq-list {
    display: grid;
    gap: .85rem;
  }

  .faq-item {
    padding: 1rem 1.1rem;
    border-radius: .9rem;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    color: var(--dark);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item p {
    margin-top: .75rem;
  }

  .contact-card {
    display: grid;
    gap: .75rem;
  }

  .contact-card strong {
    display: block;
    color: var(--dark);
    margin-bottom: .2rem;
  }

  .split-copy .section-title,
  .section-title {
    color: var(--dark);
  }

  .split-copy {
    max-width: 52rem;
    margin: 0 auto;
    text-align: center;
  }

  .security-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-bg {
    background: linear-gradient(180deg, #fff, #f8fafc);
  }

  @media (max-width: 960px) {
    .engage-hero-grid,
    .split-grid,
    .feature-grid,
    .usecase-grid,
    .benefit-grid,
    .diff-grid {
      grid-template-columns: 1fr;
    }

    .feature-grid,
    .usecase-grid,
    .benefit-grid,
    .diff-grid {
      gap: .9rem;
    }
  }
</style>
