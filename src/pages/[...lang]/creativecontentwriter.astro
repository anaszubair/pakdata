---
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'ur' } },
    { params: { lang: 'ar' } }
  ];
}

import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, getRelativeLocaleUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const copy = {
  en: {
    seoTitle: 'Creative Content Writer | PDMS Careers',
    seoDesc: 'Join PDMS as a Creative Content Writer to craft copy, scripts, and bilingual content for web, mobile, video, and social platforms.',
    badge: 'Careers',
    title: 'Creative Content Writer',
    intro: 'PDMS has been benefitting the global IT industry with its innovative, ahead of time products, since 1979; be it for Commodore 64 or now the recent mobile devices. Having our grip at Urdu script digitalization to producing mobile applications with over 100 million global downloads.',
    body: 'To keep our global audience engaged with excellent content, we are looking forward to onboard a bilingual (English & Urdu) creative copywriter, who will;',
    sectionTitle: 'Job Details',
    details: [
      'Research and write engaging content for blogs and articles',
      'Produce scripts for video content',
      'Posses excellent understanding of writing in accordance with social media trends',
      'Partner with other creative team members and key stakeholders to create content used across a variety of platforms (web, mobile, video, and social)',
      'Have dedication towards meeting deadlines, great communication skills, receiving and interpreting feedback',
      'Experience of working with TV channels or Tech companies would be a plus'
    ],
    ctaTitle: 'Interested?',
    ctaBody: 'Interested candidates can share their CV’s at careers@pakdata.com mentioning “Creative Content Writer” in the subject line.',
    back: 'Back to Join Us',
    apply: 'Email Jobs'
  },
  ur: {
    seoTitle: 'کریئیٹو کنٹینٹ رائٹر | PDMS ملازمتیں',
    seoDesc: 'PDMS میں بطور کریئیٹو کنٹینٹ رائٹر شامل ہوں اور ویب، موبائل، ویڈیو اور سوشل پلیٹ فارمز کے لیے کاپی، اسکرپٹس اور دو لسانی مواد تخلیق کریں۔',
    badge: 'ملازمتیں',
    title: 'کریئیٹو کنٹینٹ رائٹر',
    intro: 'PDMS سن 1979 سے اپنی جدید اور وقت سے آگے پروڈکٹس کے ذریعے عالمی آئی ٹی صنعت کو فائدہ پہنچا رہا ہے؛ چاہے وہ Commodore 64 ہو یا آج کے جدید موبائل آلات۔ اردو رسم الخط کی ڈیجیٹائزیشن میں مہارت سے لے کر 100 ملین سے زائد عالمی ڈاؤن لوڈز والی موبائل ایپلیکیشنز تیار کرنے تک۔',
    body: 'اپنے عالمی ناظرین کو بہترین مواد کے ذریعے جوڑے رکھنے کے لیے ہم ایک دو لسانی (انگریزی اور اردو) کریئیٹو کاپی رائٹر کو ٹیم میں شامل کرنا چاہتے ہیں، جو؛',
    sectionTitle: 'ملازمت کی تفصیلات',
    details: [
      'بلاگز اور مضامین کے لیے تحقیق کر کے دلچسپ مواد لکھے',
      'ویڈیو مواد کے لیے اسکرپٹس تیار کرے',
      'سوشل میڈیا کے رجحانات کے مطابق لکھنے کی بہترین سمجھ رکھتا ہو',
      'مختلف پلیٹ فارمز (ویب، موبائل، ویڈیو اور سوشل) پر استعمال ہونے والا مواد تیار کرنے کے لیے کریئیٹو ٹیم کے دیگر ارکان اور اہم فریقین کے ساتھ مل کر کام کرے',
      'ڈیڈ لائنز پوری کرنے کا عزم، بہترین ابلاغی صلاحیت اور فیڈ بیک لینے اور سمجھنے کی اہلیت رکھتا ہو',
      'ٹی وی چینلز یا ٹیک کمپنیوں کے ساتھ کام کا تجربہ اضافی خوبی ہوگی'
    ],
    ctaTitle: 'دلچسپی رکھتے ہیں؟',
    ctaBody: 'دلچسپی رکھنے والے امیدوار اپنی سی وی careers@pakdata.com پر بھیجیں اور سبجیکٹ لائن میں “Creative Content Writer” لکھیں۔',
    back: 'آسامیوں پر واپس جائیں',
    apply: 'ای میل کریں'
  },
  ar: {
    seoTitle: 'كاتب محتوى إبداعي | وظائف PDMS',
    seoDesc: 'انضم إلى PDMS بوظيفة كاتب محتوى إبداعي لصياغة النصوص والسيناريوهات والمحتوى ثنائي اللغة لمنصات الويب والهاتف المحمول والفيديو ووسائل التواصل الاجتماعي.',
    badge: 'الوظائف',
    title: 'كاتب محتوى إبداعي',
    intro: 'تخدم PDMS صناعة تقنية المعلومات العالمية بمنتجاتها المبتكرة والسابقة لعصرها منذ عام 1979، سواء لجهاز Commodore 64 أو لأحدث الأجهزة المحمولة اليوم. بدءًا من ريادتها في رقمنة الخط الأردي وصولًا إلى إنتاج تطبيقات للهاتف المحمول تجاوزت 100 مليون تنزيل حول العالم.',
    body: 'للحفاظ على تفاعل جمهورنا العالمي من خلال محتوى متميز، نتطلع إلى ضم كاتب نصوص إبداعي ثنائي اللغة (الإنجليزية والأردية)، يقوم بما يلي:',
    sectionTitle: 'تفاصيل الوظيفة',
    details: [
      'البحث وكتابة محتوى جذاب للمدونات والمقالات',
      'إعداد سيناريوهات لمحتوى الفيديو',
      'امتلاك فهم ممتاز للكتابة بما يتوافق مع اتجاهات وسائل التواصل الاجتماعي',
      'التعاون مع أعضاء الفريق الإبداعي الآخرين وأصحاب المصلحة الرئيسيين لإنشاء محتوى يُستخدم عبر منصات متنوعة (الويب والهاتف المحمول والفيديو ووسائل التواصل الاجتماعي)',
      'الالتزام بالمواعيد النهائية، ومهارات تواصل ممتازة، والقدرة على تلقي الملاحظات وفهمها',
      'تُعد الخبرة في العمل مع القنوات التلفزيونية أو شركات التقنية ميزة إضافية'
    ],
    ctaTitle: 'مهتم؟',
    ctaBody: 'يمكن للمرشحين المهتمين إرسال سيرهم الذاتية إلى careers@pakdata.com مع كتابة “Creative Content Writer” في سطر الموضوع.',
    back: 'العودة إلى الوظائف',
    apply: 'راسلنا بالبريد'
  }
}[lang];
---

<Layout title={copy.seoTitle} description={copy.seoDesc}>
  <section class="role-hero">
    <div class="container role-hero-grid">
      <div>
        <span class="badge badge-primary">{copy.badge}</span>
        <h1 class="role-title">{copy.title}</h1>
        <p class="role-intro">{copy.intro}</p>
        <p class="role-body">{copy.body}</p>
        <div class="role-actions">
          <a href={getRelativeLocaleUrl(lang, '/job-us')} class="btn btn-outline btn-lg">{copy.back}</a>
          <a href="mailto:careers@pakdata.com?subject=Creative%20Content%20Writer" class="btn btn-primary btn-lg">{copy.apply}</a>
        </div>
      </div>
      <div class="role-panel card">
        <span class="panel-label">{copy.sectionTitle}</span>
        <ul class="detail-list">
          {copy.details.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container role-cta card">
      <div>
        <span class="badge badge-primary">{copy.badge}</span>
        <h2 class="section-title">{copy.ctaTitle}</h2>
        <p class="body-copy">{copy.ctaBody}</p>
      </div>
      <a href="mailto:careers@pakdata.com?subject=Creative%20Content%20Writer" class="btn btn-primary btn-lg">careers@pakdata.com</a>
    </div>
  </section>
</Layout>

<style>
  .role-hero {
    background: radial-gradient(at 20% 0%, oklch(97% .04 60) 0%, transparent 50%), radial-gradient(at 80% 20%, oklch(96% .03 220) 0%, transparent 50%), linear-gradient(180deg, #fefbf8, #fff);
    border-bottom: 1px solid var(--border);
    padding: 4.5rem 0 3.5rem;
  }

  .role-hero-grid,
  .role-cta {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .role-hero-grid {
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr);
  }

  .role-title {
    color: var(--primary);
    font-size: clamp(2.2rem, 3vw, 3rem);
    line-height: 1.04;
    margin: .85rem 0 1rem;
  }

  .role-intro {
    color: var(--dark);
    font-weight: 700;
    line-height: 1.65;
    margin-bottom: .9rem;
  }

  .role-body,
  .body-copy {
    color: var(--secondary-dark);
    line-height: 1.7;
  }

  .role-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 1.2rem;
  }

  .role-panel,
  .role-cta {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    padding: 1.25rem;
  }

  .panel-label {
    display: block;
    margin-bottom: .9rem;
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .detail-list {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: .7rem;
    color: var(--secondary-dark);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .role-hero-grid,
    .role-cta {
      grid-template-columns: 1fr;
    }
  }
</style>
