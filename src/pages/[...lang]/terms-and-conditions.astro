---

<Layout title={title} description={description}>
  <section class="terms-hero">
    <div class="container text-center">
      <span class="badge badge-primary">Legal</span>
      <h1 class="terms-hero-title">Terms and Conditions</h1>
      <p class="terms-hero-subtitle">These Terms & Conditions are current as of 22 June 2020.</p>
    </div>
  </section>

  <section class="section">
    <div class="container max-width-900">
      <article class="terms-content card">
        <div class="terms-intro">
          {intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        {sections.map((section) => (
          <section class="terms-block">
            <h2 class="terms-section-title">{section.title}</h2>
            {section.lead && <p>{section.lead}</p>}
            {section.items.map((item) => <p>{item}</p>)}
          </section>
        ))}
      </article>
    </div>
  </section>
</Layout>

<style>
  .terms-hero {
    text-align: center;
    background: radial-gradient(at 20% 0%,oklch(97% .04 60) 0%,transparent 50%),radial-gradient(at 80% 20%,oklch(96% .03 220) 0%,transparent 50%),linear-gradient(180deg,oklch(99% .005 80),oklch(100% 0 0));
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
  }

  .terms-hero-title {
    font-size: calc(1.875rem * var(--text-scale, 1));
    font-weight: 700;
    margin: .75rem 0 .5rem;
    color: var(--dark);
    letter-spacing: 0;
  }

  .terms-hero-subtitle {
    max-width: 44rem;
    margin: 0 auto;
    font-size: calc(1rem * var(--text-scale, 1));
    color: var(--secondary-dark);
    line-height: 1.7;
  }

  .max-width-900 {
    max-width: 900px;
    margin: 0 auto;
  }

  .terms-content {
    padding: 3rem;
  }

  .terms-intro {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.75rem;
  }

  .terms-block + .terms-block {
    margin-top: 2rem;
  }

  .terms-section-title {
    font-size: calc(1.2rem * var(--text-scale, 1));
    font-weight: 700;
    margin: 0 0 1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: .65rem;
    color: var(--dark);
    letter-spacing: 0;
  }

  .terms-content p {
    font-size: calc(.9375rem * var(--text-scale, 1));
    color: var(--secondary-dark);
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .terms-content a {
    color: var(--primary);
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .terms-content {
      padding: 1.4rem;
    }
  }

  @media (min-width: 768px) {
    .terms-hero-title {
      font-size: calc(2.5rem * var(--text-scale, 1));
    }
  }
</style>
