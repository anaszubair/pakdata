---
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'ur' } },
    { params: { lang: 'ar' } }
  ];
}

import { getLangFromUrl, getRelativeLocaleUrl } from '../../i18n/utils';
import ContactPage from '../../components/ContactPage.astro';

const lang = getLangFromUrl(Astro.url);
const canonicalContactUrl = getRelativeLocaleUrl(lang, '/contact-us');
---

<ContactPage />

<script is:inline define:vars={{ canonicalContactUrl }}>
  if (window.location.pathname !== canonicalContactUrl) {
    window.history.replaceState(null, '', canonicalContactUrl + window.location.search + window.location.hash);
  }
</script>
