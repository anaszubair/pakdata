---
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'ur' } },
    { params: { lang: 'ar' } }
  ];
}

import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const copy = {
  en: {
    title: 'Instructions for downloading Quran audio',
    description: 'Learn how to download and install Quran audio recitations inside the Quran Majeed app on Android phones.',
    badge: 'Android Guide',
    lead: 'Please make sure that you are viewing this page in your Android phone and then follow these instructions for downloading/importing audio files in your Quran Majeed app v1.5.5 or later.',
    steps: [
      'To get the desired audio app, open the installed Quran Majeed / Quran Tafsir or Quran Pak app v1.5.5 or later. If you do not already have the Quran Majeed app, you can download it from here.',
      'Open Quran Majeed App and go to audio settings by tapping the audio settings button at the bottom as shown in the image below.',
      'Once in the audio settings, tap on reciters.',
      'To download the audio app tap on the download button shown beside the reciter’s name.',
      'A pop-up message will appear. Click on download as shown in the below image and the audio app will open in Google Play Store.',
      'Tap on install to download and install the desired audio recitation on to your Quran Majeed app.'
    ]
  },
  ur: {
    title: 'قرآن آڈیو ڈاؤن لوڈ کرنے کی ہدایات',
    description: 'Android فونز پر قرآن مجید ایپ میں قرآن کی آڈیو تلاوتیں ڈاؤن لوڈ اور انسٹال کرنے کا طریقہ جانیں۔',
    badge: 'Android گائیڈ',
    lead: 'براہِ کرم یقینی بنائیں کہ آپ یہ صفحہ اپنے Android فون پر دیکھ رہے ہیں، اور پھر قرآن مجید ایپ ورژن v1.5.5 یا اس کے بعد کے ورژن میں آڈیو فائلیں ڈاؤن لوڈ/امپورٹ کرنے کے لیے ان ہدایات پر عمل کریں۔',
    steps: [
      'اپنی پسندیدہ آڈیو ایپ حاصل کرنے کے لیے انسٹال شدہ قرآن مجید / قرآن تفسیر یا قرآن پاک ایپ ورژن v1.5.5 یا اس کے بعد کا ورژن کھولیں۔ اگر آپ کے پاس پہلے سے قرآن مجید ایپ موجود نہیں ہے تو آپ اسے یہاں سے ڈاؤن لوڈ کر سکتے ہیں۔',
      'قرآن مجید ایپ کھولیں اور نیچے دی گئی تصویر کے مطابق نیچے موجود آڈیو سیٹنگز کے بٹن پر ٹیپ کر کے آڈیو سیٹنگز میں جائیں۔',
      'آڈیو سیٹنگز میں پہنچ کر "Reciters" (قراء) پر ٹیپ کریں۔',
      'آڈیو ایپ ڈاؤن لوڈ کرنے کے لیے قاری کے نام کے ساتھ دکھائے گئے ڈاؤن لوڈ بٹن پر ٹیپ کریں۔',
      'ایک پاپ اپ پیغام ظاہر ہوگا۔ نیچے دی گئی تصویر کے مطابق "Download" پر کلک کریں، آڈیو ایپ Google Play Store میں کھل جائے گی۔',
      'اپنی پسندیدہ آڈیو تلاوت ڈاؤن لوڈ کر کے قرآن مجید ایپ میں انسٹال کرنے کے لیے "Install" پر ٹیپ کریں۔'
    ]
  },
  ar: {
    title: 'تعليمات تنزيل صوتيات القرآن',
    description: 'تعرّف على كيفية تنزيل وتثبيت التلاوات القرآنية الصوتية داخل تطبيق القرآن المجيد على هواتف Android.',
    badge: 'دليل Android',
    lead: 'يرجى التأكد من أنك تتصفح هذه الصفحة على هاتف Android، ثم اتبع هذه التعليمات لتنزيل/استيراد الملفات الصوتية في تطبيق القرآن المجيد الإصدار v1.5.5 أو أحدث.',
    steps: [
      'للحصول على التطبيق الصوتي المطلوب، افتح تطبيق القرآن المجيد / Quran Tafsir أو Quran Pak المثبّت، الإصدار v1.5.5 أو أحدث. إذا لم يكن تطبيق القرآن المجيد مثبتًا لديك، يمكنك تنزيله من هنا.',
      'افتح تطبيق القرآن المجيد وانتقل إلى إعدادات الصوت بالنقر على زر إعدادات الصوت في الأسفل كما هو موضح في الصورة أدناه.',
      'بعد الدخول إلى إعدادات الصوت، انقر على "Reciters" (القرّاء).',
      'لتنزيل التطبيق الصوتي، انقر على زر التنزيل الظاهر بجانب اسم القارئ.',
      'ستظهر رسالة منبثقة. انقر على "Download" (تنزيل) كما هو موضح في الصورة أدناه، وسيُفتح التطبيق الصوتي في Google Play Store.',
      'انقر على "Install" (تثبيت) لتنزيل التلاوة الصوتية المطلوبة وتثبيتها في تطبيق القرآن المجيد.'
    ]
  }
}[lang];

const { title, description, steps } = copy;

const images = [
  null,
  { src: '/images/qm-audio-download2.png', alt: 'Quran audio download step 2' },
  { src: '/images/qm-audio-download3.png', alt: 'Quran audio download step 3' },
  { src: '/images/qm-audio-download4.png', alt: 'Quran audio download step 4' },
  { src: '/images/qm-audio-download5.png', alt: 'Quran audio download step 5' },
  { src: '/images/qm-audio-download6.png', alt: 'Quran audio download step 6' }
];
---

<Layout title={title} description={description}>
  <section class="audio-hero">
    <div class="container audio-hero-inner">
      <span class="badge badge-primary">{copy.badge}</span>
      <h1 class="audio-title">{title}</h1>
      <p class="audio-lead">
        {copy.lead}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="steps-list">
        {steps.map((step, idx) => (
          <article class="step-card card">
            <div class="step-head">
              <span class="step-number">{idx + 1}</span>
              <p>{step}</p>
            </div>
            {images[idx] && <img src={images[idx].src} alt={images[idx].alt} class="step-image" loading="lazy" />}
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .audio-hero {
    background: radial-gradient(at 20% 0%, oklch(97% .04 60) 0%, transparent 50%), radial-gradient(at 80% 20%, oklch(96% .03 220) 0%, transparent 50%), linear-gradient(180deg, #fefbf8, #fff);
    border-bottom: 1px solid var(--border);
    padding: 4rem 0 2.5rem;
  }

  .audio-hero-inner {
    max-width: 56rem;
  }

  .audio-title {
    color: var(--primary);
    font-size: clamp(1.9rem, 3.4vw, 3.1rem);
    line-height: 1.08;
    margin: .85rem 0 1rem;
  }

  .audio-lead {
    color: var(--secondary-dark);
    line-height: 1.7;
    margin: 0;
  }

  .steps-list {
    display: grid;
    gap: .85rem;
  }

  .step-card {
    display: grid;
    gap: .85rem;
    border: 1px solid var(--border);
    border-radius: .85rem;
    background: #fff;
    box-shadow: var(--shadow-sm);
    padding: 1rem;
  }

  .step-head {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: .8rem;
    align-items: start;
  }

  .step-number {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: var(--primary-light);
    color: var(--primary);
    font-weight: 800;
  }

  .step-head p {
    margin: 0;
    color: var(--dark);
    line-height: 1.7;
    font-weight: 600;
  }

  .step-image {
    width: 100%;
    max-width: 22rem;
    display: block;
    border-radius: .75rem;
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--border);
  }

  @media (max-width: 720px) {
    .step-head {
      grid-template-columns: 1fr;
    }

    .step-image {
      max-width: 100%;
    }
  }
</style>
