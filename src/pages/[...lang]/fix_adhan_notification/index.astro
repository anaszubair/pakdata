---
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'ur' } },
    { params: { lang: 'ar' } }
  ];
}

import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl, getRelativeLocaleUrl } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const copy = {
  en: {
    seoTitle: 'Fix Adhan Notification Issue In Quran Majeed App',
    seoDesc: 'Find device-specific guides to fix adhan notifications in Quran Majeed on Samsung, Huawei, OnePlus, and generic Android devices.',
    badge: 'Adhan Help',
    title: 'Fix Adhan Notification Issue In Quran Majeed App',
    body1: 'Have you ever experienced a delay in receiving notifications, email messages or slower synchronization? This problem can be caused by the Doze function of different mobile phones which optimizes the battery life of a Smart Phone.',
    body2: 'As per the general terms, most applications use background services to get new emails, notifications, or updated information. The main function of the Doze feature is to restrict background services on Android 6 and 7 as the phone is on sleep or doze mode.',
    body3: 'If you want to solve the problem, you must deactivate the battery optimization option for Quran Majeed app. Please, check the following method for each device.',
    guidesTitle: 'Device Guides',
    deviceNote: 'Turn off battery optimization',
    devices: [
      { name: 'Samsung Galaxy', path: '/fix_adhan_notification/samsung' },
      { name: 'Google Pixel or Nexus', path: '/fix_adhan_notification/generic' },
      { name: 'Huawei', path: '/fix_adhan_notification/huawei' },
      { name: 'OnePlus', path: '/fix_adhan_notification/OnePlus' }
    ],
    note: 'If the adhan notifications are still not working, you can ask for help via support@pakdata.com.'
  },
  ur: {
    seoTitle: 'قرآن مجید ایپ میں اذان نوٹیفکیشن کا مسئلہ حل کریں',
    seoDesc: 'Samsung، Huawei، OnePlus اور عام Android ڈیوائسز پر قرآن مجید کی اذان نوٹیفکیشنز ٹھیک کرنے کے لیے ڈیوائس کے لحاظ سے گائیڈز دیکھیں۔',
    badge: 'اذان مدد',
    title: 'قرآن مجید ایپ میں اذان نوٹیفکیشن کا مسئلہ حل کریں',
    body1: 'کیا آپ کو کبھی نوٹیفکیشنز یا ای میل پیغامات موصول ہونے میں تاخیر یا سست سنکرونائزیشن کا سامنا ہوا ہے؟ یہ مسئلہ مختلف موبائل فونز کے Doze فنکشن کی وجہ سے ہو سکتا ہے جو اسمارٹ فون کی بیٹری لائف کو آپٹیمائز کرتا ہے۔',
    body2: 'عام طور پر زیادہ تر ایپس نئی ای میلز، نوٹیفکیشنز یا تازہ معلومات حاصل کرنے کے لیے بیک گراؤنڈ سروسز استعمال کرتی ہیں۔ Doze فیچر کا بنیادی کام Android 6 اور 7 پر بیک گراؤنڈ سروسز کو محدود کرنا ہے جب فون سلیپ یا doze موڈ میں ہو۔',
    body3: 'اگر آپ یہ مسئلہ حل کرنا چاہتے ہیں تو آپ کو قرآن مجید ایپ کے لیے بیٹری آپٹیمائزیشن کا آپشن بند کرنا ہوگا۔ براہِ کرم ہر ڈیوائس کے لیے درج ذیل طریقہ دیکھیں۔',
    guidesTitle: 'ڈیوائس گائیڈز',
    deviceNote: 'بیٹری آپٹیمائزیشن بند کریں',
    devices: [
      { name: 'Samsung Galaxy', path: '/fix_adhan_notification/samsung' },
      { name: 'Google Pixel یا Nexus', path: '/fix_adhan_notification/generic' },
      { name: 'Huawei', path: '/fix_adhan_notification/huawei' },
      { name: 'OnePlus', path: '/fix_adhan_notification/OnePlus' }
    ],
    note: 'اگر اذان نوٹیفکیشنز اب بھی کام نہیں کر رہیں تو آپ support@pakdata.com کے ذریعے مدد حاصل کر سکتے ہیں۔'
  },
  ar: {
    seoTitle: 'إصلاح مشكلة إشعارات الأذان في تطبيق القرآن المجيد',
    seoDesc: 'اعثر على أدلة خاصة بكل جهاز لإصلاح إشعارات الأذان في تطبيق القرآن المجيد على أجهزة Samsung وHuawei وOnePlus وأجهزة Android الأخرى.',
    badge: 'مساعدة الأذان',
    title: 'إصلاح مشكلة إشعارات الأذان في تطبيق القرآن المجيد',
    body1: 'هل واجهت يومًا تأخرًا في استلام الإشعارات أو رسائل البريد الإلكتروني أو بطئًا في المزامنة؟ قد تنتج هذه المشكلة عن وظيفة Doze في الهواتف المختلفة التي تعمل على تحسين عمر بطارية الهاتف الذكي.',
    body2: 'بشكل عام، تستخدم معظم التطبيقات خدمات الخلفية للحصول على رسائل البريد الإلكتروني أو الإشعارات أو المعلومات المحدّثة. والوظيفة الأساسية لميزة Doze هي تقييد خدمات الخلفية على Android 6 و7 عندما يكون الهاتف في وضع السكون.',
    body3: 'إذا كنت تريد حل المشكلة، فيجب عليك تعطيل خيار تحسين البطارية لتطبيق القرآن المجيد. يرجى مراجعة الطريقة التالية لكل جهاز.',
    guidesTitle: 'أدلة الأجهزة',
    deviceNote: 'إيقاف تحسين البطارية',
    devices: [
      { name: 'Samsung Galaxy', path: '/fix_adhan_notification/samsung' },
      { name: 'Google Pixel أو Nexus', path: '/fix_adhan_notification/generic' },
      { name: 'Huawei', path: '/fix_adhan_notification/huawei' },
      { name: 'OnePlus', path: '/fix_adhan_notification/OnePlus' }
    ],
    note: 'إذا كانت إشعارات الأذان ما تزال لا تعمل، يمكنك طلب المساعدة عبر support@pakdata.com.'
  }
}[lang];
---

<Layout title={copy.seoTitle} description={copy.seoDesc}>
  <section class="page-hero">
    <div class="container hero-inner">
      <span class="badge badge-primary">{copy.badge}</span>
      <h1 class="page-title">{copy.title}</h1>
      <p class="page-body">{copy.body1}</p>
      <p class="page-body">{copy.body2}</p>
      <p class="page-body">{copy.body3}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title-wrap tight">
        <span class="badge badge-primary">{copy.badge}</span>
        <h2 class="section-title">{copy.guidesTitle}</h2>
      </div>
      <div class="device-grid">
        {copy.devices.map((device) => (
          <a href={getRelativeLocaleUrl(lang, device.path)} class="device-card card">
            <strong>{device.name}</strong>
            <span>{copy.deviceNote}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-bg">
    <div class="container note-card card">
      <p>{copy.note}</p>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: radial-gradient(at 20% 0%, oklch(97% .04 60) 0%, transparent 50%), radial-gradient(at 80% 20%, oklch(96% .03 220) 0%, transparent 50%), linear-gradient(180deg, #fefbf8, #fff);
    border-bottom: 1px solid var(--border);
    padding: 4rem 0 2.5rem;
  }

  .hero-inner {
    max-width: 52rem;
  }

  .page-title {
    color: var(--primary);
    font-size: clamp(1.9rem, 3.2vw, 3rem);
    line-height: 1.08;
    margin: .8rem 0 1rem;
  }

  .page-body {
    color: var(--secondary-dark);
    line-height: 1.7;
    margin: 0 0 .75rem;
  }

  .device-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .85rem;
  }

  .device-card,
  .note-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: .85rem;
    box-shadow: var(--shadow-sm);
    padding: 1rem;
  }

  .device-card {
    display: grid;
    gap: .25rem;
    color: var(--dark);
  }

  .device-card strong {
    font-size: 1rem;
  }

  .device-card span {
    color: var(--secondary-dark);
  }

  .note-card p {
    margin: 0;
    color: var(--secondary-dark);
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .device-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
